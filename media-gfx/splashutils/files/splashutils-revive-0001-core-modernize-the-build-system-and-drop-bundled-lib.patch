+dnl SPLASH_CHECK_STATIC(what, VAR, pkgs, extra-libs, alternative)
+dnl Make sure a static link really works before committing to it, so a
+dnl missing .a shows up here instead of halfway through the build.
+AC_DEFUN([SPLASH_CHECK_STATIC], [
+  AC_MSG_CHECKING([whether $1 can be linked statically])
+  $2_STATIC_CFLAGS=$($PKG_CONFIG --static --cflags $3 2>/dev/null)
+  $2_STATIC_LIBS="$($PKG_CONFIG --static --libs $3 2>/dev/null) $4"
+  splash_save_LIBS="$LIBS"; splash_save_CFLAGS="$CFLAGS"; splash_save_LDFLAGS="$LDFLAGS"
+  LIBS="$$2_STATIC_LIBS $LIBS"; CFLAGS="$CFLAGS $$2_STATIC_CFLAGS"; LDFLAGS="$LDFLAGS -static"
+  AC_LINK_IFELSE([AC_LANG_PROGRAM([[#include <stdio.h>
+#include <jpeglib.h>]], [[struct jpeg_decompress_struct c; jpeg_create_decompress(&c);]])],
+    [AC_MSG_RESULT([yes])],
+    [AC_MSG_RESULT([no])
+     AC_MSG_ERROR([cannot link $1 statically; install static libraries for: $3 (Gentoo: USE=static-libs), or configure with $5])])
+  LIBS="$splash_save_LIBS"; CFLAGS="$splash_save_CFLAGS"; LDFLAGS="$splash_save_LDFLAGS"
+  AC_SUBST([$2_STATIC_CFLAGS])
+  AC_SUBST([$2_STATIC_LIBS])
+])
+
+AS_IF([test "x${config_helper}" = "xyes" && test "x${config_static_helper}" = "xyes"], [
+  SPLASH_CHECK_STATIC([the kernel helper], [HELPER], [${splash_static_pkgs} ${splash_static_ttf}], [-lm],
+    [--disable-static-helper])
+])
+AS_IF([test "x${config_static_binaries}" = "xyes"], [
+  splash_ctl_pkgs="${splash_static_pkgs}"
+  AS_IF([test "x${config_ttf}" = "xyes"], [splash_ctl_pkgs="${splash_ctl_pkgs} freetype2"])
+  AS_IF([test "x${config_mng}" = "xyes"], [splash_ctl_pkgs="${splash_ctl_pkgs} libmng"])
+  SPLASH_CHECK_STATIC([fbsplashctl], [CTL], [${splash_ctl_pkgs}], [${GPM_LIBS} -lpthread -lm],
+    [--disable-static-binaries])
+])
+
+AM_CONDITIONAL([CONFIG_HELPER], [test "x${config_helper}" = "xyes"])
+AM_CONDITIONAL([CONFIG_STATIC_HELPER], [test "x${config_static_helper}" = "xyes"])
+AM_CONDITIONAL([CONFIG_STATIC_BINARIES], [test "x${config_static_binaries}" = "xyes"])
+AS_IF([test "x${config_static_binaries}" = "xyes"],
+  [AC_DEFINE([CONFIG_STATIC_BINARIES], [1], [Define to 1 to build statically linked binaries.])])
 
