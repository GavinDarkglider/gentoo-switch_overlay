index 0000000..662c799
--- /dev/null
+++ b/core/src/test/test_blit.c
@@ -0,0 +1,108 @@
+/*
+ * Check the rotation-aware blitter in effects.c against the mapping the
+ * kernel framebuffer console uses (fbcon_cw.c & co., fbcondecor).
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "common.h"
+#include "render.h"
+
+struct fb_data fbd;
+sendian_t endianess = little;
+
+/* logical screen (sx, sy) -> physical (px, py), as in the kernel */
+static void l2p(int rot, int X, int Y, int sx, int sy, int *px, int *py)
+{
+	switch (rot) {
+	case FB_ROTATE_CW:  *px = X - 1 - sy; *py = sx; break;
+	case FB_ROTATE_UD:  *px = X - 1 - sx; *py = Y - 1 - sy; break;
+	case FB_ROTATE_CCW: *px = sy; *py = Y - 1 - sx; break;
+	default:            *px = sx; *py = sy; break;
+	}
+}
+
+static int run(int rot, int bpp, int X, int Y, int pad, int tw, int th,
+	       int x1, int y1, int x2, int y2)
+{
+	stheme_t theme = { 0 };
+	int lx = (rot & 1) ? Y : X, ly = (rot & 1) ? X : Y;
+	int ll = X * bpp + pad, x, y, err = 0;
+	u8 *src, *dst;
+
+	memset(&fbd, 0, sizeof(fbd));
+	fbd.var.xres = X;
+	fbd.var.yres = Y;
+	fbd.fix.line_length = ll;
+	fbd.bytespp = bpp;
+	fbd.rotate = rot;
+
+	theme.xres = tw;
+	theme.yres = th;
+	theme.xmarg = (lx - tw) / 2;
+	theme.ymarg = (ly - th) / 2;
+
+	src = malloc(tw * th * bpp);
+	dst = malloc(ll * Y);
+	for (y = 0; y < th; y++)
+		for (x = 0; x < tw; x++) {
+			u32 v = 0x01000000 | (y << 12) | x;
+			memcpy(src + (y * tw + x) * bpp, &v, bpp);
+		}
+	memset(dst, 0xee, ll * Y);
+
+	paint_rect(&theme, dst, src, x1, y1, x2, y2);
+
+	/* The blitter clips to the theme; so does the check. */
+	if (x1 < 0) x1 = 0;
+	if (y1 < 0) y1 = 0;
+	if (x2 >= tw) x2 = tw - 1;
+	if (y2 >= th) y2 = th - 1;
+
+	/* Every pixel of the rectangle where the kernel would put it ... */
+	for (y = y1; y <= y2; y++)
+		for (x = x1; x <= x2; x++) {
+			int px, py;
+
+			l2p(rot, X, Y, x + theme.xmarg, y + theme.ymarg, &px, &py);
+			if (memcmp(dst + py * ll + px * bpp, src + (y * tw + x) * bpp, bpp)) {
+				if (err++ < 3)
+					fprintf(stderr, "rot %d bpp %d: theme (%d,%d) not at (%d,%d)\n",
+						rot, bpp, x, y, px, py);
+			}
+			memset(dst + py * ll + px * bpp, 0xee, bpp);
+		}
+
+	/* ... and nothing anywhere else. */
+	for (x = 0; x < ll * Y; x++)
+		if (dst[x] != 0xee) {
+			fprintf(stderr, "rot %d bpp %d: stray write at offset %d\n", rot, bpp, x);
+			err++;
+			break;
+		}
+
+	free(src);
+	free(dst);
+	return err;
+}
+
+int main(void)
+{
+	int rot, bpp, err = 0;
+
+	for (rot = 0; rot < 4; rot++)
+		for (bpp = 2; bpp <= 4; bpp++) {
+			/* whole theme filling a non-square screen */
+			err += run(rot, bpp, 7, 5, 0, (rot & 1) ? 5 : 7, (rot & 1) ? 7 : 5,
+				   0, 0, 10, 10);
+			/* smaller theme centered, padded lines, sub-rectangle */
+			err += run(rot, bpp, 11, 8, 12, (rot & 1) ? 6 : 9, (rot & 1) ? 9 : 6,
+				   1, 2, 4, 4);
+			/* rectangle partly outside the theme gets clipped */
+			err += run(rot, bpp, 11, 8, 4, 5, 5, -3, 3, 9, 20);
+		}
+
+	printf("blitter: %s\n", err ? "FAILED" : "ok");
+	return err ? 1 : 0;
+}
