+/* Copy one pixel of fbd.bytespp bytes. */
+static inline void copy_px(u8 *dst, const u8 *src)
+{
+	switch (fbd.bytespp) {
+	case 4:
+		*(u32 *)dst = *(const u32 *)src;
+		break;
+	case 2:
+		*(u16 *)dst = *(const u16 *)src;
+		break;
+	default:
+		memcpy(dst, src, fbd.bytespp);
+		break;
+	}
+}
+
+/*
+ * Copy the rectangle [x1,x2] x [y1,y2] (inclusive, theme coordinates) of
+ * @src, a theme->xres x theme->yres image, to the framebuffer at @dst.
+ *
+ * The theme is placed at (xmarg, ymarg) on the logical screen, which is
+ * mapped onto the framebuffer according to fbd.rotate, the same way the
+ * kernel's framebuffer console does it.  The framebuffer is written in
+ * physical row order; @src is read with whatever stride that implies.
+ */
+static void blit_rect(stheme_t *theme, u8 *dst, const u8 *src,
+		      int x1, int y1, int x2, int y2)
+{
+	const int bpp = fbd.bytespp, ll = fbd.fix.line_length;
+	const int X = fbd.var.xres, Y = fbd.var.yres;
+	const long sstride = (long)theme->xres * bpp;
+	int sx1, sy1, sx2, sy2, px1, px2, py1, py2, px, py;
+	long step;
+
+	if (!dst)
+		return;
+
+	/* Clip to the theme. */
+	if (x1 < 0)
+		x1 = 0;
+	if (y1 < 0)
+		y1 = 0;
+	if (x2 >= theme->xres)
+		x2 = theme->xres - 1;
+	if (y2 >= theme->yres)
+		y2 = theme->yres - 1;
+	if (x1 > x2 || y1 > y2)
+		return;
+
+	if (fbd.rotate == FB_ROTATE_UR) {
+		int len = (x2 - x1 + 1) * bpp;
+
+		for (py = y1; py <= y2; py++)
+			memcpy(dst + (py + theme->ymarg) * ll + (x1 + theme->xmarg) * bpp,
+			       src + py * sstride + x1 * bpp, len);
+		return;
+	}
+
+	/* Logical screen rectangle ... */
+	sx1 = x1 + theme->xmarg;
+	sx2 = x2 + theme->xmarg;
+	sy1 = y1 + theme->ymarg;
+	sy2 = y2 + theme->ymarg;
+
+	/* ... and the physical rectangle it ends up in. */
+	switch (fbd.rotate) {
+	case FB_ROTATE_CW:		/* (sx,sy) -> (X-1-sy, sx) */
+		px1 = X - 1 - sy2; px2 = X - 1 - sy1;
+		py1 = sx1;         py2 = sx2;
+		break;
+	case FB_ROTATE_UD:		/* (sx,sy) -> (X-1-sx, Y-1-sy) */
+		px1 = X - 1 - sx2; px2 = X - 1 - sx1;
+		py1 = Y - 1 - sy2; py2 = Y - 1 - sy1;
+		break;
+	default:			/* CCW: (sx,sy) -> (sy, Y-1-sx) */
+		px1 = sy1;         px2 = sy2;
+		py1 = Y - 1 - sx2; py2 = Y - 1 - sx1;
+		break;
+	}
+
+	if (px1 < 0 || py1 < 0 || px2 >= X || py2 >= Y)
+		return;
+
+	for (py = py1; py <= py2; py++) {
+		u8 *d = dst + py * ll + px1 * bpp;
+		const u8 *s;
+		int sx, sy;
+
+		/* Theme pixel for (px1, py) and how it moves as px grows. */
+		switch (fbd.rotate) {
+		case FB_ROTATE_CW:
+			sx = py;
+			sy = X - 1 - px1;
+			step = -sstride;
+			break;
+		case FB_ROTATE_UD:
+			sx = X - 1 - px1;
+			sy = Y - 1 - py;
+			step = -bpp;
+			break;
+		default:
+			sx = Y - 1 - py;
+			sy = px1;
+			step = sstride;
+			break;
+		}
+
+		s = src + (sy - theme->ymarg) * sstride + (sx - theme->xmarg) * bpp;
+		for (px = px1; px <= px2; px++, d += bpp, s += step)
+			copy_px(d, s);
+	}
+}
