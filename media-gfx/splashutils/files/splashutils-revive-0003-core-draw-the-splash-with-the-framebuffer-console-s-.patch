+/*
+ * Look for fbcon=rotate:N on the kernel command line.
+ * Returns -1 if it isn't there.
+ */
+static int kcmdline_fbcon_rotate(void)
+{
+	char buf[1024], *p;
+	FILE *fp;
+	int rot = -1;
+
+	fp = fopen(PATH_PROC "/cmdline", "r");
+	if (!fp)
+		return -1;
+	if (!fgets(buf, sizeof(buf), fp))
+		buf[0] = 0;
+	fclose(fp);
+
+	for (p = buf; (p = strstr(p, "fbcon=")); p++) {
+		char *o = p + 6;
+
+		/* fbcon options are comma separated, the last one wins */
+		while (o && *o && *o != ' ' && *o != '\n') {
+			if (!strncmp(o, "rotate:", 7))
+				rot = strtol(o + 7, NULL, 0);
+			o = strpbrk(o, ", \n");
+			if (o && *o == ',')
+				o++;
+			else
+				break;
+		}
+	}
+
+	return (rot >= 0 && rot <= 3) ? rot : -1;
+}
+
+/**
+ * Get the rotation the splash has to be drawn with so that it matches the
+ * framebuffer console: config.rotate (splash=rotate:N) if set, otherwise
+ * the current fbcon rotation from sysfs, otherwise fbcon=rotate:N from the
+ * kernel command line.
+ *
+ * @return FB_ROTATE_UR (0), FB_ROTATE_CW (1), FB_ROTATE_UD (2) or
+ *         FB_ROTATE_CCW (3).
+ */
+int fbsplash_get_rotation(void)
+{
+	FILE *fp;
+	int rot = -1;
+
+	if (config.rotate >= 0 && config.rotate <= 3)
+		return config.rotate;
+
+	fp = fopen(PATH_SYS "/class/graphics/fbcon/rotate", "r");
+	if (fp) {
+		if (fscanf(fp, "%d", &rot) != 1)
+			rot = -1;
+		fclose(fp);
+	}
+
+	if (rot < 0 || rot > 3)
+		rot = kcmdline_fbcon_rotate();
+
+	return (rot >= 0 && rot <= 3) ? rot : 0;
+}
