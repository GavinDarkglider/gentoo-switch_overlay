From c2cdc4e57d5729797f9f2cc719d0e53b48838c86 Mon Sep 17 00:00:00 2001
From: gavin_darkglider <rbrown4014@gmail.com>
Date: Fri, 23 Oct 2026 22:20:02 -0700
Subject: [PATCH 04/13] gentoo: update the OpenRC plugin and init script for
 current OpenRC

- Include <sys/queue.h>: current rc.h no longer pulls it in.
- Start fbsplashd with fork/execv instead of system(): BOOT_MSG and the
  theme name were pasted into a shell command line run as root.
- Clear the global service list after freeing it; OpenRC calls the hook
  repeatedly in one process, so it was used after free.
- Return the hook's error code instead of discarding it, and report
  splash_svcs_start() failures.
- The GPM wait loop waited while /dev/gpmctl existed instead of until it
  appeared.
- Makefile: use pkg-config (openrc, einfo, libfbsplash) and install into
  OpenRC's pluginsdir; keep the required flags out of CFLAGS so a
  command-line CFLAGS (ebuilds) doesn't drop them.
- init-fbcondecor: #!/sbin/openrc-run (runscript is gone).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_013zuE5eXGVUDWEu4YZj7gYa
---
 gentoo/.gitignore      |  2 +-
 gentoo/Makefile        | 32 ++++++++++++--------
 gentoo/init-fbcondecor |  2 +-
 gentoo/splash.c        | 68 +++++++++++++++++++++++++++++-------------
 4 files changed, 68 insertions(+), 36 deletions(-)

diff --git a/gentoo/.gitignore b/gentoo/.gitignore
index 68cecf0..8f042a6 100644
--- a/gentoo/.gitignore
+++ b/gentoo/.gitignore
@@ -1,3 +1,3 @@
+splash.so
 *.o
-*.so
 test
diff --git a/gentoo/Makefile b/gentoo/Makefile
index 44fee03..4a041fb 100644
--- a/gentoo/Makefile
+++ b/gentoo/Makefile
@@ -1,24 +1,30 @@
-# Makefile for the splash baselayout plugin.
+# Makefile for the splash OpenRC plugin.
 #
+# Needs OpenRC's librc/libeinfo and an installed (or built) splashutils
+# core; set PKG_CONFIG_PATH if they live somewhere unusual.
 
-LIB		?= lib
-CFLAGS 	+= -g -Wall
-LDFLAGS += -L../core/objs/.libs -L../core/.libs
+PKG_CONFIG ?= pkg-config
+LIB        ?= lib
+PLUGINDIR  ?= $(shell $(PKG_CONFIG) --variable=pluginsdir openrc 2>/dev/null || echo /$(LIB)/rc/plugins)
 
-INCLUDES = -I../core/objs -I../core -I../core/src -I../core/objs/src
+CFLAGS  ?= -O2 -g
+# Kept separate so CFLAGS from the command line (e.g. an ebuild) don't drop them.
+PLUGIN_CFLAGS = -Wall -fPIC $(shell $(PKG_CONFIG) --cflags openrc einfo libfbsplash)
+LDLIBS   = $(shell $(PKG_CONFIG) --libs openrc einfo libfbsplash)
+
+%.o: %.c
+	$(CC) $(CPPFLAGS) $(PLUGIN_CFLAGS) $(CFLAGS) -c $< -o $@
 
 splash.so: splash.o
-	$(CC) $(LDFLAGS) -fPIC -shared -Wl,-soname,$@ $+ -o $@ -leinfo -lrc -lfbsplash
+	$(CC) $(LDFLAGS) -shared -Wl,-soname,$@ -Wl,--no-undefined $^ -o $@ $(LDLIBS)
 
 test: test.o
-	$(CC) $+ -o $@ -leinfo -lrc -ldl
-
-%.o: %.c
-	$(CC) $(CFLAGS) $(INCLUDES) -fPIC -c -o $@ $<
+	$(CC) $(LDFLAGS) $^ -o $@ $(shell $(PKG_CONFIG) --libs openrc einfo) -ldl
 
-install:
-	install -D splash.so $(DESTDIR)/$(LIB)/rc/plugins/splash.so
+install: splash.so
+	install -D -m 755 splash.so $(DESTDIR)$(PLUGINDIR)/splash.so
 
 clean:
-	rm -rf *.o *.so
+	rm -f *.o *.so test
 
+.PHONY: install clean
