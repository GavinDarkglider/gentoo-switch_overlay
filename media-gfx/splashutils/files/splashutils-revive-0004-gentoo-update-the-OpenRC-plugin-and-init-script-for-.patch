diff --git a/gentoo/splash.c b/gentoo/splash.c
index 5220571..3390a12 100644
--- a/gentoo/splash.c
+++ b/gentoo/splash.c
@@ -11,6 +11,7 @@
  * more details.
  *
  */
+#include <sys/queue.h>
 #include <sys/stat.h>
 #include <errno.h>
 #include <stdio.h>
@@ -578,7 +579,7 @@ int splash_svcs_start()
 
 out:
 	fclose(fp);
-	return 0;
+	return err;
 }
 
 /*
@@ -629,8 +630,10 @@ out:
 static int splash_start(const char *runlevel)
 {
 	bool start;
-	int err = 0;
-	char buf[2048];
+	int err = 0, status, n = 0;
+	char theme[256], pidfile[256], type[32];
+	char *argv[12];
+	pid_t pid;
 	RC_STRING *s;
 
 	/* Get a list of services that we'll have to handle. */
@@ -654,20 +657,42 @@ static int splash_start(const char *runlevel)
 	if (fbsplash_check_sanity())
 		return -1;
 
-	/* Start the splash daemon */
-	snprintf(buf, 2048, "BOOT_MSG='%s' " FBSPLASH_DAEMON " --theme=\"%s\" --pidfile=" FBSPLASH_PIDFILE " --type=%s %s %s %s",
-			 config->message, config->theme,
-			 (config->type == fbspl_reboot) ? "reboot" : ((config->type == fbspl_shutdown) ? "shutdown" : "bootup"),
-			 (config->kdmode == KD_GRAPHICS) ? "--kdgraphics" : "",
-			 (config->textbox_visible) ? "--textbox" : "",
-			 ((config->effects & (FBSPL_EFF_FADEOUT | FBSPL_EFF_FADEIN)) == (FBSPL_EFF_FADEOUT | FBSPL_EFF_FADEIN)) ? "--effects=fadeout,fadein" :
-				 ((config->effects & FBSPL_EFF_FADEOUT) ? "--effects=fadeout" :
-					 ((config->effects & FBSPL_EFF_FADEIN) ? "--effects=fadein" : "")));
-
-	err = system(buf);
-	if (err == -1 || WEXITSTATUS(err) != 0) {
-		eerror("Failed to start the splash daemon, error code %d", err);
-		return err;
+	/* Start the splash daemon.  Run it directly instead of through a
+	 * shell: the message and theme come from the kernel command line and
+	 * config files and must not be interpreted. */
+	snprintf(theme, sizeof(theme), "--theme=%s", config->theme);
+	snprintf(pidfile, sizeof(pidfile), "--pidfile=%s", FBSPLASH_PIDFILE);
+	snprintf(type, sizeof(type), "--type=%s",
+		 (config->type == fbspl_reboot) ? "reboot" :
+		 ((config->type == fbspl_shutdown) ? "shutdown" : "bootup"));
+
+	argv[n++] = FBSPLASH_DAEMON;
+	argv[n++] = theme;
+	argv[n++] = pidfile;
+	argv[n++] = type;
+	if (config->kdmode == KD_GRAPHICS)
+		argv[n++] = "--kdgraphics";
+	if (config->textbox_visible)
+		argv[n++] = "--textbox";
+	if ((config->effects & (FBSPL_EFF_FADEOUT | FBSPL_EFF_FADEIN)) == (FBSPL_EFF_FADEOUT | FBSPL_EFF_FADEIN))
+		argv[n++] = "--effects=fadeout,fadein";
+	else if (config->effects & FBSPL_EFF_FADEOUT)
+		argv[n++] = "--effects=fadeout";
+	else if (config->effects & FBSPL_EFF_FADEIN)
+		argv[n++] = "--effects=fadein";
+	argv[n] = NULL;
+
+	pid = fork();
+	if (pid == 0) {
+		if (config->message)
+			setenv("BOOT_MSG", config->message, 1);
+		execv(argv[0], argv);
+		_exit(127);
+	}
+	if (pid < 0 || waitpid(pid, &status, 0) < 0 ||
+	    !WIFEXITED(status) || WEXITSTATUS(status) != 0) {
+		eerror("Failed to start the splash daemon (%s)", argv[0]);
+		return -1;
 	}
 
 	err = splash_init(start);
@@ -933,7 +958,7 @@ do_start:
 				int cnt = 0;
 				gpm = true;
 				/* Wait up to 0.25s for the GPM socket to appear. */
-				while (stat("/dev/gpmctl", &st) == 0 && cnt < 25) {
+				while (stat("/dev/gpmctl", &st) != 0 && cnt < 25) {
 					usleep(10000);
 					cnt++;
 				}
@@ -1005,8 +1030,9 @@ do_start:
 		break;
 	}
 
-exit:	
+exit:
 	rc_stringlist_free(svcs);
-	free (runlev);
-	return i;
+	svcs = NULL;
+	free(runlev);
+	return retval ? retval : i;
 }
