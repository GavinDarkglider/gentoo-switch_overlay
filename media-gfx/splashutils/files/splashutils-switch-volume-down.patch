diff --git a/core/src/daemon_cmd.c b/core/src/daemon_cmd.c
index a3a7fd6..7cbf9a2 100644
--- a/core/src/daemon_cmd.c
+++ b/core/src/daemon_cmd.c
@@ -235,21 +235,36 @@ int cmd_set_tty(void **args)
 /*
  * 'set event dev' command handler.
  *
- * Sets a new event device to monitor for keypresses.
+ * Sets the event devices to monitor for keypresses: one, or several
+ * separated by commas.
  */
 int cmd_set_event_dev(void **args)
 {
+	char *list, *dev, *save;
+	int fd;
+
+	if (!args[0])
+		return -1;
+
 	if (evdev)
 		free(evdev);
 
 	evdev = strdup(args[0]);
 
 	pthread_cancel(th_switchmon);
+	pthread_join(th_switchmon, NULL);
 
-	if (fd_evdev != -1)
-		close(fd_evdev);
+	while (evdev_cnt > 0)
+		close(fd_evdev[--evdev_cnt]);
 
-	fd_evdev = open(evdev, O_RDONLY);
+	list = strdup(evdev);
+	for (dev = strtok_r(list, ",\n", &save); dev && evdev_cnt < EVDEV_MAX;
+	     dev = strtok_r(NULL, ",\n", &save)) {
+		fd = open(dev, O_RDONLY);
+		if (fd != -1)
+			fd_evdev[evdev_cnt++] = fd;
+	}
+	free(list);
 
 	switchmon_start(UPD_MON, config.tty_s);
 
diff --git a/core/src/libfbsplash.c b/core/src/libfbsplash.c
index b4e8f42..8ed7654 100644
--- a/core/src/libfbsplash.c
+++ b/core/src/libfbsplash.c
@@ -661,6 +661,81 @@ err:
 	return -1;
 }
 
+/*
+ * Does the input device (an inputN directory in sysfs) have the key?
+ * capabilities/key is a bitmap in hex words, the highest word first.
+ */
+static int input_has_key(const char *dir, int key)
+{
+	char buf[1024], path[PATH_MAX], *words[64], *t, *save;
+	unsigned long w;
+	int n = 0, bits = sizeof(long) * 8, idx;
+	FILE *fp;
+
+	snprintf(path, sizeof(path), "%s/capabilities/key", dir);
+	fp = fopen(path, "r");
+	if (!fp)
+		return 0;
+	if (!fgets(buf, sizeof(buf), fp))
+		buf[0] = 0;
+	fclose(fp);
+
+	for (t = strtok_r(buf, " \n", &save); t && n < 64; t = strtok_r(NULL, " \n", &save))
+		words[n++] = t;
+
+	idx = n - 1 - key / bits;
+	if (idx < 0)
+		return 0;
+	w = strtoul(words[idx], NULL, 16);
+	return (w >> (key % bits)) & 1;
+}
+
+/*
+ * The event devices that have F2 or Vol-, as a "/dev/input/eventN" list
+ * separated by commas, into buf.  Vol- lets devices without a keyboard
+ * (handhelds, the Nintendo Switch) switch to verbose mode.
+ *
+ * @return The number of devices found.
+ */
+static int find_evdevs(char *buf, size_t len)
+{
+	char dir[PATH_MAX];
+	struct dirent *in, *ev;
+	DIR *cls, *d;
+	size_t used = 0;
+	int cnt = 0;
+
+	buf[0] = 0;
+	cls = opendir(PATH_SYS "/class/input");
+	if (!cls)
+		return 0;
+
+	while ((in = readdir(cls))) {
+		if (strncmp(in->d_name, "input", 5))
+			continue;
+		snprintf(dir, sizeof(dir), PATH_SYS "/class/input/%s", in->d_name);
+		if (!input_has_key(dir, KEY_F2) && !input_has_key(dir, KEY_VOLUMEDOWN))
+			continue;
+
+		d = opendir(dir);
+		if (!d)
+			continue;
+		while ((ev = readdir(d))) {
+			if (strncmp(ev->d_name, "event", 5))
+				continue;
+			if (used + strlen(PATH_DEV) + strlen(ev->d_name) + 9 < len) {
+				used += snprintf(buf + used, len - used, "%s" PATH_DEV "/input/%s",
+						cnt ? "," : "", ev->d_name);
+				cnt++;
+			}
+			break;
+		}
+		closedir(d);
+	}
+	closedir(cls);
+	return cnt;
+}
+
 /**
  * Try to set the event device for the splash daemon.
  *
@@ -679,6 +754,14 @@ int fbsplash_set_evdev(void)
 		"/bin/grep -s -m 1 '^H: Handlers=kbd' " PATH_PROC "/bus/input/devices | /bin/grep -o 'event[0-9]\\+'"
 	};
 
+	char list[1024];
+
+	/* Every device with F2 or Vol- */
+	if (find_evdevs(list, sizeof(list)) > 0) {
+		fbsplash_send("set event dev %s\n", list);
+		return 0;
+	}
+
 	/* Try to activate the event device interface so that F2 can
 	 * be used to switch from verbose to silent. */
 	buf[0] = 0;
