--- a/core/src/daemon.c
+++ b/core/src/daemon.c
@@ -25,6 +25,7 @@
 #include <dirent.h>
 #include <time.h>
 #include <getopt.h>
+#include <poll.h>
 
 #include "common.h"
 #include "daemon.h"
@@ -41,7 +42,8 @@ pthread_t th_switchmon, th_sighandler, th_anim;
 int ctty = CTTY_VERBOSE;
 
 /* File descriptors */
-int fd_evdev = -1;
+int fd_evdev[EVDEV_MAX];
+int evdev_cnt = 0;
 #ifdef CONFIG_GPM
 int fd_gpm = -1;
 #endif
@@ -407,13 +409,27 @@ void* thf_sighandler(void *unusued)
  */
 void* thf_switch_evdev(void *unused)
 {
-	int i, h, oldstate;
-	size_t rb;
+	int i, d, h, oldstate;
+	ssize_t rb;
 	struct input_event ev[8];
+	struct pollfd pfd[EVDEV_MAX];
+
+	for (d = 0; d < evdev_cnt; d++) {
+		pfd[d].fd = fd_evdev[d];
+		pfd[d].events = POLLIN;
+	}
 
 	while (1) {
-		rb = read(fd_evdev, ev, sizeof(struct input_event)*8);
-		if (rb < (int) sizeof(struct input_event))
+		/* poll() is a cancellation point */
+		if (poll(pfd, evdev_cnt, -1) < 0)
+			continue;
+
+		for (d = 0; d < evdev_cnt; d++) {
+		if (!(pfd[d].revents & POLLIN))
+			continue;
+
+		rb = read(pfd[d].fd, ev, sizeof(struct input_event)*8);
+		if (rb < (ssize_t) sizeof(struct input_event))
 			continue;
 
 		for (i = 0; i < (int) (rb / sizeof(struct input_event)); i++) {
@@ -421,6 +437,9 @@ void* thf_switch_evdev(void *unused)
 				continue;
 
 			switch (ev[i].code) {
+			/* Vol- for devices without a keyboard (handhelds,
+			 * tablets, the Nintendo Switch) */
+			case KEY_VOLUMEDOWN:
 			case KEY_F2:
 				pthread_setcancelstate(PTHREAD_CANCEL_DISABLE, &oldstate);
 				pthread_mutex_lock(&mtx_paint);
@@ -451,6 +470,7 @@ void* thf_switch_evdev(void *unused)
 				break;
 			}
 		}
+		}
 	}
 
 	pthread_exit(NULL);
@@ -522,7 +542,7 @@ void switchmon_start(int update, int stty)
 
 	/* Do we have to start a monitor thread? */
 	if (update & UPD_MON) {
-		if (fd_evdev != -1) {
+		if (evdev_cnt > 0) {
 			if (pthread_create(&th_switchmon, NULL, &thf_switch_evdev, NULL)) {
 				iprint(MSG_ERROR, "Evdev monitor thread creation failed.\n");
 				exit(3);
