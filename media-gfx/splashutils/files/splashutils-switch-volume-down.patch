 core/src/daemon.c      | 32 +++++++++++++---
 core/src/daemon.h      | 10 +++--
 core/src/daemon_cmd.c  | 23 ++++++++++--
 core/src/libfbsplash.c | 83 ++++++++++++++++++++++++++++++++++++++++++
 5 files changed, 137 insertions(+), 17 deletions(-)

