# Nintendo switch hardware
CHOST=aarch64-unknown-linux-gnu
CPU_FLAGS_ARM="edsp neon thumb vfp vfpv3 vfpv4 vfp-d32 aes sha1 sha2 crc32 v4 v5 v6 v7 v8 thumb2"

CFLAGS="-march=armv8-a+crypto+crc+simd -mlittle-endian -mabi=lp64 -mtune=cortex-a57 -O3 -pipe"
CXXFLAGS="${CFLAGS}"

USE="pulseaudio"         # Without them the sound switch between TV and handheld mode is difficult
USE="$USE vulkan"        # Graphics acceleration
USE="$USE gstreamer v4l" # Video acceleration

INPUT_DEVICES="libinput joystick"

VIDEO_CARDS="tegra"
