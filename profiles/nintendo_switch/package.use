# Gavin 2021-06-14 needed for xauth to generate auth files correctly.
x11-base/xorg-server xcsecurity

# Gavin 2022-04-25 Required in own ffmpeg fork
media-video/ffmpeg nvv4l2 -dav1d

# bell07 2022-05-15 required for kernel less than 4.11.
dev-qt/qtcore old-kernel

# Gavin 2026-11-08 from 2.44-r5, glibc is built for Linux 6.1 and later unless
# USE=old-kernel (then 3.2.0); the Switch runs the L4T 4.9 kernel
sys-libs/glibc old-kernel

# bell07 2026-01-14 required by dev-embedded/u-boot-tools
sys-apps/dtc python

# bell07 2026-03-15 as proposed in https://gitlab.com/l4t-community/gnu-linux/fedora-copr/moonlight-qt/-/blob/master/moonlight-qt.spec?ref_type=heads#L50
# -vulkan because vulkan is masked for ffmpeg currently
net-misc/moonlight -drm -vaapi -vulkan

# Gavin 2026-10-31 The Tegra GPU is driven by NVIDIA's libraries (jetson-tx1-drivers,
# through libglvnd); mesa is only needed for libgbm, xorg-server's glamor and as a
# software fallback. Its llvm is only for llvmpipe/AMD and pulls in two LLVM slots.
media-libs/mesa -llvm
# Gavin 2026-11-09 No mesa unless something really uses it: NVIDIA's X driver doesn't
# use glamor, and gtk:4 / gst-plugins-base (copies in this repo) take GL from
# libglvnd. USE=gbm (sys-apps/nintendo-switch-meta, Wayland/KMS) brings mesa's
# libgbm back.
x11-base/xorg-server -glamor

# Gavin 2026-11-01 The Switch has no cellular modem: no ModemManager stack (libmbim,
# libqmi, libqrtr-glib, mobile-broadband-provider-info) for NetworkManager.
net-misc/networkmanager -modemmanager
# If something still pulls ModemManager in (NetworkManager[bluetooth] requires it):
# libqrtr-glib needs struct qrtr_ctrl_pkt from kernel >= 4.15 headers; ours are 4.9.
net-misc/modemmanager -qrtr
net-libs/libqmi -qrtr

# Gavin 2026-11-01 app-crypt/pinentry[gtk] (the desktop's password prompt) needs
# app-crypt/gcr:4[gtk]; the base profile has gtk off for it.
app-crypt/gcr gtk
