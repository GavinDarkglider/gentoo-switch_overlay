# Gavin 2021-06-14 needed for xauth to generate auth files correctly.
x11-base/xorg-server xcsecurity

# Gavin 2022-04-25 Required in own ffmpeg fork
media-video/ffmpeg nvv4l2 -dav1d

# bell07 2022-05-15 required for kernel less than 4.11.
dev-qt/qtcore old-kernel

# bell07 2026-01-14 required by dev-embedded/u-boot-tools
sys-apps/dtc python

# bell07 2026-03-15 as proposed in https://gitlab.com/l4t-community/gnu-linux/fedora-copr/moonlight-qt/-/blob/master/moonlight-qt.spec?ref_type=heads#L50
# -vulkan because vulkan is masked for ffmpeg currently
net-misc/moonlight -drm -vaapi -vulkan
