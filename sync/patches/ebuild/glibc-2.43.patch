# Reason: Old-kernel compatibility and L4T boot-chain adjustments; plus remove MFD_HUGETLB define so Firefox uses its fallback.
--- a/glibc-2.43-r6.ebuild
+++ b/glibc-2.43-r6.ebuild
@@ -869,11 +869,11 @@
 			[[ ${I_ALLOW_TO_BREAK_MY_SYSTEM} = yes ]] || die "Aborting to save your system."
 		fi
 
-		if is_linux && ! do_run_test '#include <unistd.h>\n#include <sys/syscall.h>\nint main(){return syscall(1000)!=-1;}\n' ; then
-			eerror "Your old kernel is broken. You need to update it to a newer"
-			eerror "version as syscall(<bignum>) will break. See bug 279260."
-			[[ ${I_ALLOW_TO_BREAK_MY_SYSTEM} = yes ]] || die "Old and broken kernel."
-		fi
+#		if is_linux && ! do_run_test '#include <unistd.h>\n#include <sys/syscall.h>\nint main(){return syscall(1000)!=-1;}\n' ; then
+#			eerror "Your old kernel is broken. You need to update it to a newer"
+#			eerror "version as syscall(<bignum>) will break. See bug 279260."
+#			[[ ${I_ALLOW_TO_BREAK_MY_SYSTEM} = yes ]] || die "Old and broken kernel."
+#		fi
 	fi
 
 	if [[ ${CTARGET} == i386-* ]] ; then
@@ -1075,6 +1075,18 @@
 	chmod u+x "${S}"/scripts/*.sh
 
 	cd "${S}" || die
+
+	# Firefox needs MFD_HUGETLB to be undefined so it uses its own
+	# fallback; glibc defines it even though the Switch kernel does not
+	# provide it consistently.
+	sed -i '/#  define MFD_HUGETLB 4U/d' sysdeps/unix/sysv/linux/bits/mman-shared.h || die
+
+	# NSW old kernel. Remove symbols not in old kernel
+	sed -i \
+		-e "s:# define STATX_DIOALIGN 0x2000U::g" \
+		"${S}"/io/bits/statx-generic.h \
+		|| die "patching statx-generic.h failed"
+	# NSW old kernel end
 }
 
 # src_configure
@@ -1518,6 +1530,14 @@
 
 	# We'll take care of the cache ourselves
 	rm -f "${ED}"/etc/ld.so.cache
+
+	# NSW old kernel. Remove symbols not in old kernel
+	# Hacky version, just remove from target file before installation
+	sed -i \
+		-e "s:# define STATX_BASIC_STATS 0x07ffU::g" \
+		"${ED}"/"$(alt_headers)"/bits/statx-generic.h \
+		|| die "patching statx-generic.h failed"
+	# NSW old kernel end
 
 	# Everything past this point just needs to be done once ...
 	is_final_abi || return 0
