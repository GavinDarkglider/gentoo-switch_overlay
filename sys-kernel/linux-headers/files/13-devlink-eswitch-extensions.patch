From ab79fd76b667462ba8ed66c17ff6528a6aa0f8f3 Mon Sep 17 00:00:00 2001
From: GavinDarkglider <rbrown4014@yahoo.com>
Date: Sun, 1 Nov 2026 11:49:17 -0800
Subject: [PATCH] uapi: devlink: eswitch command aliases, inline and encap mode

Header only, for building newer userspace (NetworkManager). The command
names are upstream's aliases of the eswitch mode commands;
DEVLINK_ATTR_ESWITCH_ENCAP_MODE is 62 as upstream (27 is
DEVLINK_ATTR_DPIPE_TABLES there). The 4.9 kernel ignores attributes it
doesn't know.

---
 include/uapi/linux/devlink.h | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/include/uapi/linux/devlink.h b/include/uapi/linux/devlink.h
index 915bfa74458c..d1c4aae589de 100644
--- a/include/uapi/linux/devlink.h
+++ b/include/uapi/linux/devlink.h
@@ -59,6 +59,8 @@ enum devlink_command {
 
 	DEVLINK_CMD_ESWITCH_MODE_GET,
 	DEVLINK_CMD_ESWITCH_MODE_SET,
+        DEVLINK_CMD_ESWITCH_GET = DEVLINK_CMD_ESWITCH_MODE_GET,
+        DEVLINK_CMD_ESWITCH_SET = DEVLINK_CMD_ESWITCH_MODE_SET,
 	/* add new commands above here */
 
 	__DEVLINK_CMD_MAX,
@@ -133,6 +135,8 @@ enum devlink_attr {
 	DEVLINK_ATTR_SB_OCC_CUR,		/* u32 */
 	DEVLINK_ATTR_SB_OCC_MAX,		/* u32 */
 	DEVLINK_ATTR_ESWITCH_MODE,		/* u16 */
+        DEVLINK_ATTR_ESWITCH_INLINE_MODE,		/* u8 */
+	DEVLINK_ATTR_ESWITCH_ENCAP_MODE = 62,	/* u8 */
 
 	/* add new attributes above here, update the policy in devlink.c */
 
-- 
