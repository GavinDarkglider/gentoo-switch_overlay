diff -Nru a/drivers/video/console/cfbcondecor.c b/drivers/video/console/cfbcondecor.c
--- a/drivers/video/console/cfbcondecor.c	1969-12-31 16:00:00.000000000 -0800
+++ b/drivers/video/console/cfbcondecor.c	2026-11-08 01:22:18.276340873 -0800
@@ -0,0 +1,635 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ *  cfbcondecor.c -- Framebuffer console decoration render functions
+ *
+ *  Copyright (C) 2004 Michal Januszewski <michalj+fbcondecor@gmail.com>
+ *
+ *  Code based upon "Bootdecor" (C) 2001-2003
+ *       Volker Poplawski <volker@poplawski.de>,
+ *       Stefan Reinauer <stepan@suse.de>,
+ *       Steffen Winterfeldt <snwint@suse.de>,
+ *       Michael Schroeder <mls@suse.de>,
+ *       Ken Wimer <wimer@suse.de>.
+ *
+ *  Rotation support and port to the 6.x fbcon core:
+ *       gavin_darkglider
+ *  Backport of that to the 4.9 fbcon core (L4T)
+ *
+ *  All drawing functions take console (logical) coordinates and translate
+ *  them into physical framebuffer rectangles with decor_l2p(), so the same
+ *  code handles FB_ROTATE_UR/CW/UD/CCW.  Glyphs come from vc->vc_font for an
+ *  upright console and from fbcon's pre-rotated font buffer otherwise; the
+ *  background picture is already stored in physical order (see
+ *  fbcon_decor_layout_pic()).
+ */
+#include <linux/fb.h>
+#include <linux/kernel.h>
+#include <linux/sched.h>
+#include <linux/string.h>
+#include <asm/unaligned.h>
+#include <linux/vt_kern.h>
+#include <linux/selection.h>
+
+#include "fbcon.h"
+#include "fbcondecor.h"
+
+struct decor_rect {
+	int x, y, w, h;
+};
+
+/* Where and how to draw: the visible part of the framebuffer. */
+struct decor_dst {
+	struct fb_info *info;
+	u8 *base;		/* visible origin; __iomem unless @sys */
+	const u8 *pic;		/* matching origin inside info->bgdecor */
+	u32 pitch;		/* framebuffer line length */
+	u32 pic_pitch;		/* picture line length */
+	u32 bytespp;
+	u32 xres, yres;
+	bool sys;		/* framebuffer lives in system memory */
+};
+
+static void decor_dst_init(struct decor_dst *d, struct fb_info *info)
+{
+	d->info = info;
+	d->bytespp = DIV_ROUND_UP(info->var.bits_per_pixel, 8);
+	d->pitch = info->fix.line_length;
+	d->pic_pitch = info->var.xres * d->bytespp;
+	d->xres = info->var.xres;
+	d->yres = info->var.yres;
+	d->sys = info->flags & FBINFO_VIRTFB;
+	d->base = (u8 __force *)info->screen_base +
+		  info->var.yoffset * d->pitch +
+		  info->var.xoffset * d->bytespp;
+	d->pic = (const u8 *)info->bgdecor.data;
+
+	/* Don't race CPU writes against a pending accelerated operation. */
+	if (info->fbops->fb_sync)
+		info->fbops->fb_sync(info);
+}
+
+/*
+ * Map a logical rectangle onto the physical framebuffer.  This mirrors the
+ * placement used by fbcon's own rotated blitters (fbcon_cw.c etc.).
+ */
+static void decor_l2p(const struct decor_dst *d, int rotate, int lx, int ly,
+		      int lw, int lh, struct decor_rect *r)
+{
+	switch (rotate) {
+	case FB_ROTATE_CW:
+		r->x = d->xres - (ly + lh);
+		r->y = lx;
+		r->w = lh;
+		r->h = lw;
+		break;
+	case FB_ROTATE_UD:
+		r->x = d->xres - (lx + lw);
+		r->y = d->yres - (ly + lh);
+		r->w = lw;
+		r->h = lh;
+		break;
+	case FB_ROTATE_CCW:
+		r->x = ly;
+		r->y = d->yres - (lx + lw);
+		r->w = lh;
+		r->h = lw;
+		break;
+	default:
+		r->x = lx;
+		r->y = ly;
+		r->w = lw;
+		r->h = lh;
+		break;
+	}
+}
+
+static bool decor_clip(const struct decor_dst *d, struct decor_rect *r)
+{
+	int x2 = min_t(int, r->x + r->w, d->xres);
+	int y2 = min_t(int, r->y + r->h, d->yres);
+
+	r->x = max(r->x, 0);
+	r->y = max(r->y, 0);
+	r->w = x2 - r->x;
+	r->h = y2 - r->y;
+
+	return r->w > 0 && r->h > 0;
+}
+
+static bool decor_inside(const struct decor_dst *d, const struct decor_rect *r)
+{
+	return r->x >= 0 && r->y >= 0 && r->w > 0 && r->h > 0 &&
+	       r->x + r->w <= d->xres && r->y + r->h <= d->yres;
+}
+
+/*
+ * Tell deferred-I/O drivers (DRM fbdev emulation, USB displays, ...) which
+ * area changed.  Their only damage hook is the drawing ops, so do an in-place
+ * copyarea over the rectangle we just wrote.
+ */
+static void decor_damage(const struct decor_dst *d, struct decor_rect r)
+{
+#ifdef CONFIG_FB_DEFERRED_IO
+	struct fb_info *info = d->info;
+	struct fb_copyarea area;
+
+	if (!info->fbdefio || !info->fbops->fb_copyarea || !decor_clip(d, &r))
+		return;
+
+	area.sx = area.dx = r.x + info->var.xoffset;
+	area.sy = area.dy = r.y + info->var.yoffset;
+	area.width = r.w;
+	area.height = r.h;
+	info->fbops->fb_copyarea(info, &area);
+#endif
+}
+
+static inline u32 decor_col(const struct fb_info *info, int c)
+{
+	if (info->fix.visual == FB_VISUAL_TRUECOLOR ||
+	    info->fix.visual == FB_VISUAL_DIRECTCOLOR)
+		return ((u32 *)info->pseudo_palette)[c];
+	return c;
+}
+
+/* Raw pixel value in framebuffer memory order. */
+static inline u32 decor_get(const struct decor_dst *d, const u8 *p)
+{
+	switch (d->bytespp) {
+	case 4:
+		return get_unaligned((const u32 *)p);
+	case 2:
+		return get_unaligned((const u16 *)p);
+	case 1:
+		return *p;
+	default:
+#ifdef __BIG_ENDIAN
+		return (p[0] << 16) | (p[1] << 8) | p[2];
+#else
+		return p[0] | (p[1] << 8) | (p[2] << 16);
+#endif
+	}
+}
+
+static inline void decor_put(const struct decor_dst *d, u8 *p, u32 v)
+{
+	if (d->sys) {
+		switch (d->bytespp) {
+		case 4:
+			put_unaligned(v, (u32 *)p);
+			return;
+		case 2:
+			put_unaligned((u16)v, (u16 *)p);
+			return;
+		case 1:
+			*p = v;
+			return;
+		}
+#ifdef __BIG_ENDIAN
+		p[0] = v >> 16;
+		p[1] = v >> 8;
+		p[2] = v;
+#else
+		p[0] = v;
+		p[1] = v >> 8;
+		p[2] = v >> 16;
+#endif
+	} else {
+		u8 __iomem *io = (u8 __iomem __force *)p;
+
+		switch (d->bytespp) {
+		case 4:
+			fb_writel(v, io);
+			return;
+		case 2:
+			fb_writew(v, io);
+			return;
+		case 1:
+			fb_writeb(v, io);
+			return;
+		}
+#ifdef __BIG_ENDIAN
+		fb_writeb(v >> 16, io);
+		fb_writeb(v >> 8, io + 1);
+		fb_writeb(v, io + 2);
+#else
+		fb_writeb(v, io);
+		fb_writeb(v >> 8, io + 1);
+		fb_writeb(v >> 16, io + 2);
+#endif
+	}
+}
+
+/* Restore a physical rectangle from the background picture. */
+static void decor_fill_pic(const struct decor_dst *d, struct decor_rect r)
+{
+	size_t len;
+	u8 *dst;
+	const u8 *src;
+
+	if (!decor_clip(d, &r))
+		return;
+
+	len = r.w * d->bytespp;
+	dst = d->base + r.y * d->pitch + r.x * d->bytespp;
+	src = d->pic + r.y * d->pic_pitch + r.x * d->bytespp;
+
+	while (r.h--) {
+		if (d->sys)
+			memcpy(dst, src, len);
+		else
+			fb_memcpy_tofb((u8 __iomem __force *)dst, src, len);
+		dst += d->pitch;
+		src += d->pic_pitch;
+	}
+}
+
+/* Fill a physical rectangle with a solid (already converted) color. */
+static void decor_fill(const struct decor_dst *d, struct decor_rect r, u32 v)
+{
+	u8 *row;
+	int x;
+
+	if (!decor_clip(d, &r))
+		return;
+
+	row = d->base + r.y * d->pitch + r.x * d->bytespp;
+	while (r.h--) {
+		u8 *p = row;
+
+		for (x = 0; x < r.w; x++, p += d->bytespp)
+			decor_put(d, p, v);
+		row += d->pitch;
+	}
+}
+
+/*
+ * Draw a 1bpp bitmap (rows padded to whole bytes) at physical rectangle @r.
+ * Clear bits show the picture when @transparent, @bgx otherwise.
+ */
+static void decor_bitmap(const struct decor_dst *d, const struct decor_rect *r,
+			 const u8 *src, u32 fgx, u32 bgx, bool transparent)
+{
+	u32 spitch = DIV_ROUND_UP(r->w, 8);
+	u8 *row;
+	const u8 *pic;
+	int x, y;
+
+	if (!decor_inside(d, r))
+		return;
+
+	row = d->base + r->y * d->pitch + r->x * d->bytespp;
+	pic = d->pic + r->y * d->pic_pitch + r->x * d->bytespp;
+
+	for (y = 0; y < r->h; y++) {
+		u8 *p = row;
+		const u8 *q = pic;
+
+		for (x = 0; x < r->w; x++) {
+			u32 v;
+
+			if (src[x >> 3] & (0x80 >> (x & 7)))
+				v = fgx;
+			else if (transparent)
+				v = decor_get(d, q);
+			else
+				v = bgx;
+
+			decor_put(d, p, v);
+			p += d->bytespp;
+			q += d->bytespp;
+		}
+		src += spitch;
+		row += d->pitch;
+		pic += d->pic_pitch;
+	}
+}
+
+/*
+ * Glyph for character @c as fbcon would draw it with the current rotation.
+ * Returns NULL if no suitably rotated font is available.
+ */
+static const u8 *decor_glyph(struct vc_data *vc, struct fb_info *info, u16 c)
+{
+	struct fbcon_ops *par = info->fbcon_par;
+	unsigned short charmask = vc->vc_hi_font_mask ? 0x1ff : 0xff;
+	u32 gw = vc->vc_font.width, gh = vc->vc_font.height;
+	u32 cellsize;
+
+	c &= charmask;
+	/* Clamp to font size, same as bit_putcs_aligned() */
+	if (c >= vc->vc_font.charcount)
+		c = 0;
+
+	if (par->rotate == FB_ROTATE_UR)
+		return vc->vc_font.data ?
+			vc->vc_font.data + c * DIV_ROUND_UP(gw, 8) * gh : NULL;
+
+	if (par->rotate == FB_ROTATE_CW || par->rotate == FB_ROTATE_CCW)
+		swap(gw, gh);
+	cellsize = DIV_ROUND_UP(gw, 8) * gh;
+
+	if (!par->fontbuffer || (c + 1) * cellsize > par->fd_size)
+		return NULL;
+
+	return par->fontbuffer + c * cellsize;
+}
+
+void fbcon_decor_fix_pseudo_pal(struct fb_info *info, struct vc_data *vc)
+{
+	int minlen = min3(info->var.red.length, info->var.green.length,
+			  info->var.blue.length);
+	int i, j, k;
+	u32 col;
+
+	if (!info->pseudo_palette || minlen <= 0 || minlen > 8)
+		return;
+
+	for (j = i = 0; i < 16; i++) {
+		k = color_table[i];
+
+		col = ((vc->vc_palette[j++] >> (8 - minlen))
+			<< info->var.red.offset);
+		col |= ((vc->vc_palette[j++] >> (8 - minlen))
+			<< info->var.green.offset);
+		col |= ((vc->vc_palette[j++] >> (8 - minlen))
+			<< info->var.blue.offset);
+		((u32 *)info->pseudo_palette)[k] = col;
+	}
+}
+
+void fbcon_decor_putcs(struct vc_data *vc, struct fb_info *info,
+		       const unsigned short *s, int count, int yy, int xx,
+		       int fg, int bg)
+{
+	struct fbcon_ops *par = info->fbcon_par;
+	int fw = vc->vc_font.width, fh = vc->vc_font.height;
+	int lx = vc->vc_decor.tx + xx * fw;
+	int ly = vc->vc_decor.ty + yy * fh;
+	struct decor_dst d;
+	struct decor_rect r;
+	bool transparent;
+	u32 fgx, bgx;
+	int i;
+
+	if (count <= 0)
+		return;
+
+	decor_dst_init(&d, info);
+
+	/* Don't paint the background image if console is blanked */
+	transparent = !par->blank_state && vc->vc_decor.bg_color == bg;
+	fgx = decor_col(info, fg);
+	bgx = decor_col(info, bg);
+
+	for (i = 0; i < count; i++) {
+		const u8 *src = decor_glyph(vc, info, scr_readw(s++));
+
+		if (!src)
+			break;
+
+		decor_l2p(&d, par->rotate, lx + i * fw, ly, fw, fh, &r);
+		decor_bitmap(&d, &r, src, fgx, bgx, transparent);
+	}
+
+	decor_l2p(&d, par->rotate, lx, ly, count * fw, fh, &r);
+	decor_damage(&d, r);
+}
+
+void fbcon_decor_cursor(struct vc_data *vc, struct fb_info *info,
+			const struct fb_cursor *cursor)
+{
+	/* fbcon fonts are at most 32x32 in 4.9 (con_font_set()) */
+	static u8 buf[DIV_ROUND_UP(32, 8) * 32];
+	struct fbcon_ops *par = info->fbcon_par;
+	int fw = vc->vc_font.width, fh = vc->vc_font.height;
+	u32 w = cursor->image.width, h = cursor->image.height;
+	u32 dsize = DIV_ROUND_UP(w, 8) * h;
+	struct decor_dst d;
+	struct decor_rect r;
+	const u8 *data = (const u8 *)cursor->image.data;
+	u32 i;
+
+	/* we really don't need any cursors while the console is blanked */
+	if (info->state != FBINFO_STATE_RUNNING || par->blank_state)
+		return;
+
+	if (!data || dsize > sizeof(buf) ||
+	    vc->vc_x >= vc->vc_cols || vc->vc_y >= vc->vc_rows)
+		return;
+
+	/* @buf is serialized by the console lock. */
+	if (cursor->enable && cursor->mask) {
+		for (i = 0; i < dsize; i++)
+			buf[i] = cursor->rop == ROP_XOR ?
+				data[i] ^ cursor->mask[i] :
+				data[i] & cursor->mask[i];
+	} else {
+		memcpy(buf, data, dsize);
+	}
+
+	decor_dst_init(&d, info);
+	decor_l2p(&d, par->rotate, vc->vc_decor.tx + vc->vc_x * fw,
+		  vc->vc_decor.ty + vc->vc_y * fh, fw, fh, &r);
+	if (r.w != w || r.h != h)
+		return;
+
+	decor_bitmap(&d, &r, buf, decor_col(info, cursor->image.fg_color),
+		     decor_col(info, cursor->image.bg_color),
+		     cursor->image.bg_color == vc->vc_decor.bg_color);
+	decor_damage(&d, r);
+}
+
+void fbcon_decor_clear(struct vc_data *vc, struct fb_info *info, int sy,
+		       int sx, int height, int width, int bg)
+{
+	struct fbcon_ops *par = info->fbcon_par;
+	int fw = vc->vc_font.width, fh = vc->vc_font.height;
+	struct decor_dst d;
+	struct decor_rect r;
+
+	decor_dst_init(&d, info);
+	decor_l2p(&d, par->rotate, vc->vc_decor.tx + sx * fw,
+		  vc->vc_decor.ty + sy * fh, width * fw, height * fh, &r);
+
+	/* Don't paint the background image if console is blanked */
+	if (vc->vc_decor.bg_color == bg && !par->blank_state)
+		decor_fill_pic(&d, r);
+	else
+		decor_fill(&d, r, decor_col(info, bg));
+	decor_damage(&d, r);
+}
+
+static void decor_margin(const struct decor_dst *d, int rotate,
+			 int lx, int ly, int lw, int lh)
+{
+	struct decor_rect r;
+
+	if (lw <= 0 || lh <= 0)
+		return;
+
+	decor_l2p(d, rotate, lx, ly, lw, lh, &r);
+	decor_fill_pic(d, r);
+	decor_damage(d, r);
+}
+
+void fbcon_decor_clear_margins(struct vc_data *vc, struct fb_info *info,
+			       int bottom_only)
+{
+	struct fbcon_ops *par = info->fbcon_par;
+	int rotate = par->rotate;
+	int lw = FBCON_SWAP(rotate, info->var.xres, info->var.yres);
+	int lh = FBCON_SWAP(rotate, info->var.yres, info->var.xres);
+	int tx = vc->vc_decor.tx, ty = vc->vc_decor.ty;
+	int tw = vc->vc_cols * vc->vc_font.width;
+	int th = vc->vc_rows * vc->vc_font.height;
+	struct decor_dst d;
+
+	decor_dst_init(&d, info);
+
+	if (!bottom_only) {
+		/* top margin */
+		decor_margin(&d, rotate, 0, 0, lw, ty);
+		/* left margin */
+		decor_margin(&d, rotate, 0, ty, tx, th);
+		/* right margin */
+		decor_margin(&d, rotate, tx + tw, ty, lw - tx - tw, th);
+	}
+	/* bottom margin */
+	decor_margin(&d, rotate, 0, ty + th, lw, lh - ty - th);
+}
+
+/* Paint the whole visible screen black. */
+void fbcon_decor_wipe(struct fb_info *info)
+{
+	struct decor_dst d;
+	struct decor_rect r = { 0, 0, info->var.xres, info->var.yres };
+
+	if (!info->screen_base || !fbcon_decor_bpp_ok(info->var.bits_per_pixel))
+		return;
+
+	decor_dst_init(&d, info);
+	decor_fill(&d, r, 0);
+	decor_damage(&d, r);
+}
+
+void fbcon_decor_blank(struct vc_data *vc, struct fb_info *info, int blank)
+{
+	/* On unblank fbcon_blank() redraws the screen, margins included. */
+	if (blank)
+		fbcon_decor_wipe(info);
+}
+
+/*
+ * Picture layout.  Map a logical pixel to its physical location and back;
+ * @xres/@yres are the physical dimensions.
+ */
+static inline void decor_l2p_px(int rotate, u32 xres, u32 yres,
+				u32 lx, u32 ly, u32 *px, u32 *py)
+{
+	switch (rotate) {
+	case FB_ROTATE_CW:
+		*px = xres - 1 - ly;
+		*py = lx;
+		break;
+	case FB_ROTATE_UD:
+		*px = xres - 1 - lx;
+		*py = yres - 1 - ly;
+		break;
+	case FB_ROTATE_CCW:
+		*px = ly;
+		*py = yres - 1 - lx;
+		break;
+	default:
+		*px = lx;
+		*py = ly;
+		break;
+	}
+}
+
+static inline void decor_p2l_px(int rotate, u32 xres, u32 yres,
+				u32 px, u32 py, u32 *lx, u32 *ly)
+{
+	switch (rotate) {
+	case FB_ROTATE_CW:
+		*lx = py;
+		*ly = xres - 1 - px;
+		break;
+	case FB_ROTATE_UD:
+		*lx = xres - 1 - px;
+		*ly = yres - 1 - py;
+		break;
+	case FB_ROTATE_CCW:
+		*lx = yres - 1 - py;
+		*ly = px;
+		break;
+	default:
+		*lx = px;
+		*ly = py;
+		break;
+	}
+}
+
+static inline void decor_copy_px(u8 *dst, const u8 *src, u32 bytespp)
+{
+	switch (bytespp) {
+	case 4:
+		put_unaligned(get_unaligned((const u32 *)src), (u32 *)dst);
+		break;
+	case 2:
+		put_unaligned(get_unaligned((const u16 *)src), (u16 *)dst);
+		break;
+	default:
+		memcpy(dst, src, bytespp);
+		break;
+	}
+}
+
+/*
+ * Lay out a picture supplied in logical orientation (as the viewer sees the
+ * rotated console) into physical framebuffer order for @rotate.
+ */
+void fbcon_decor_layout_pic(u8 *dst, const u8 *src, u32 xres, u32 yres,
+			    u32 bytespp, int rotate)
+{
+	u32 lw = FBCON_SWAP(rotate, xres, yres);
+	u32 lh = FBCON_SWAP(rotate, yres, xres);
+	u32 lx, ly, px, py;
+
+	if (rotate == FB_ROTATE_UR) {
+		memcpy(dst, src, (size_t)xres * yres * bytespp);
+		return;
+	}
+
+	for (ly = 0; ly < lh; ly++) {
+		for (lx = 0; lx < lw; lx++) {
+			decor_l2p_px(rotate, xres, yres, lx, ly, &px, &py);
+			decor_copy_px(dst + ((size_t)py * xres + px) * bytespp,
+				      src, bytespp);
+			src += bytespp;
+		}
+		cond_resched();
+	}
+}
+
+/*
+ * Re-lay a physical picture laid out for rotation @from so that it is laid
+ * out for rotation @to.  Only valid when both rotations have the same
+ * logical dimensions (UR <-> UD, CW <-> CCW, or a square mode).
+ */
+void fbcon_decor_relayout_pic(u8 *dst, const u8 *src, u32 xres, u32 yres,
+			      u32 bytespp, int from, int to)
+{
+	u32 px, py, lx, ly, qx, qy;
+
+	for (py = 0; py < yres; py++) {
+		for (px = 0; px < xres; px++) {
+			decor_p2l_px(from, xres, yres, px, py, &lx, &ly);
+			decor_l2p_px(to, xres, yres, lx, ly, &qx, &qy);
+			decor_copy_px(dst + ((size_t)qy * xres + qx) * bytespp,
+				      src, bytespp);
+			src += bytespp;
+		}
+		cond_resched();
+	}
+}
