diff -Nru a/include/linux/console_decor.h b/include/linux/console_decor.h
--- a/include/linux/console_decor.h	1969-12-31 16:00:00.000000000 -0800
+++ b/include/linux/console_decor.h	2026-11-08 01:22:18.294249024 -0800
@@ -0,0 +1,25 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _LINUX_CONSOLE_DECOR_H_
+#define _LINUX_CONSOLE_DECOR_H_ 1
+
+#include <linux/types.h>
+
+/*
+ * Per virtual console state of the framebuffer console decorations
+ * (drivers/video/console/fbcondecor.c).
+ *
+ * The layout matches what the FBIOCONDECOR_{SET,GET}CFG ioctls exchange
+ * with userspace, with @theme pointing to a kernel copy of the theme name.
+ *
+ * All coordinates are in console (logical) space, i.e. as the viewer sees
+ * the console after fbcon rotation has been applied.
+ */
+struct vc_decor {
+	__u8 bg_color;		/* The color that is to be treated as transparent */
+	__u8 state;		/* Current decor state: 0 = off, 1 = on */
+	__u16 tx, ty;		/* Top left corner coordinates of the text field */
+	__u16 twidth, theight;	/* Width and height of the text field */
+	char *theme;
+};
+
+#endif /* _LINUX_CONSOLE_DECOR_H_ */
