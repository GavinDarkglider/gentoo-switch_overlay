+ *  License.  See the file COPYING in the main directory of this archive for
+ *  more details.
+ */
+#include <linux/bitmap.h>
+#include <linux/compat.h>
+#include <linux/console.h>
+#include <linux/fb.h>
+#include <linux/fs.h>
+#include <linux/kernel.h>
+#include <linux/miscdevice.h>
+#include <linux/module.h>
+#include <linux/slab.h>
+#include <linux/spinlock.h>
+#include <linux/string.h>
+#include <linux/sysctl.h>
+#include <linux/uaccess.h>
+#include <linux/kmod.h>
+#include <linux/vmalloc.h>
+#include <linux/vt_kern.h>
+#include <linux/workqueue.h>
+
+#include "fbcon.h"
+#include "fbcondecor.h"
+
+#define FBCON_DECOR_PATH_LEN	256
+
+static char fbcon_decor_path[FBCON_DECOR_PATH_LEN] = "/sbin/fbcondecor_helper";
+
+static struct ctl_table fbcon_decor_sysctl[] = {
+	{
+		.procname	= "fbcondecor",
+		.data		= fbcon_decor_path,
+		.maxlen		= FBCON_DECOR_PATH_LEN,
+		.mode		= 0644,
+		.proc_handler	= proc_dostring,
+	},
+	{ }
+};
+
+/* xres * yres * bytespp, or 0 if that doesn't fit (no array3_size() in 4.9) */
+static size_t fbcon_decor_pic_size(u32 xres, u32 yres, u32 bytespp)
+{
+	u64 size = (u64)xres * yres * bytespp;
+
+	return size > SIZE_MAX / 2 ? 0 : (size_t)size;
+}
+
+static struct workqueue_struct *fbcon_decor_wq;
+static struct ctl_table_header *fbcon_decor_sysctl_hdr;
+static bool fbcon_decor_registered;
+
+/* ---------------------------------------------------------------------- */
+/* Userspace helper                                                        */
+/* ---------------------------------------------------------------------- */
+
+struct fbcon_decor_helper {
+	struct work_struct work;
+	char cmd[16];
+	char tcons[8];
+	char tfb[8];
+	char theme[FBCON_DECOR_THEME_LEN];
+};
+
+static void fbcon_decor_helper_fn(struct work_struct *work)
+{
+	struct fbcon_decor_helper *h =
+		container_of(work, struct fbcon_decor_helper, work);
+	static char *envp[] = {
+		"HOME=/",
+		"PATH=/sbin:/bin:/usr/sbin:/usr/bin",
+		NULL
+	};
+	char path[FBCON_DECOR_PATH_LEN];
+	char *argv[] = {
+		path,
+		"2",
+		h->cmd,
+		h->tcons,
+		h->tfb,
+		h->theme[0] ? h->theme : NULL,
+		NULL
+	};
+
+	strscpy(path, fbcon_decor_path, sizeof(path));
+	if (path[0])
+		call_usermodehelper(path, argv, envp, UMH_WAIT_EXEC);
+
+	kfree(h);
+}
+
+/*
+ * Ask the userspace helper to do something for @vc.  Never sleeps: the
+ * helper is started from a workqueue, so it is safe to call with the console
+ * lock held (the helper will typically issue ioctls that need it).
+ */
+void fbcon_decor_call_helper(const char *cmd, struct vc_data *vc,
+			     struct fb_info *info)
+{
+	struct fbcon_decor_helper *h;
+
+	if (!fbcon_decor_wq)
+		return;
+
+	h = kzalloc(sizeof(*h), GFP_ATOMIC);
+	if (!h)
+		return;
+
+	INIT_WORK(&h->work, fbcon_decor_helper_fn);
+	strscpy(h->cmd, cmd, sizeof(h->cmd));
+	snprintf(h->tcons, sizeof(h->tcons), "%d", vc->vc_num);
+	snprintf(h->tfb, sizeof(h->tfb), "%d", info ? info->node : 0);
+	if (vc->vc_decor.theme)
+		strscpy(h->theme, vc->vc_decor.theme, sizeof(h->theme));
+
+	queue_work(fbcon_decor_wq, &h->work);
+}
+
+/* ---------------------------------------------------------------------- */
+/* State changes (all called with the console lock held)                  */
+/* ---------------------------------------------------------------------- */
+
+static void fbcon_decor_resize_full(struct vc_data *vc, struct fb_info *info)
+{
+	int rotate = fbcon_decor_vc_rotate(vc, info);
+
+	vc_resize(vc,
+		  FBCON_SWAP(rotate, info->var.xres, info->var.yres) /
+			vc->vc_font.width,
+		  FBCON_SWAP(rotate, info->var.yres, info->var.xres) /
+			vc->vc_font.height);
+}
+
+/* Disables fbcondecor on a virtual console; called with console sem held. */
+int fbcon_decor_disable(struct vc_data *vc, bool redraw)
+{
+	struct fb_info *info;
+
+	WARN_CONSOLE_UNLOCKED();
+
+	if (!vc->vc_decor.state)
+		return -EINVAL;
+
+	info = fbcon_decor_info(vc->vc_num);
+	if (!info)
+		return -EINVAL;
+
+	vc->vc_decor.state = 0;
+	fbcon_decor_resize_full(vc, info);
+
+	if (redraw && con_is_visible(vc))
+		redraw_screen(vc, 0);
+
+	pr_info("fbcondecor: switched decor state to 'off' on console %d\n",
+		vc->vc_num);
+
+	return 0;
+}
+
+/*
+ * Make sure the picture on @info can be used for @vc with the rotation @vc
+ * is displayed with, re-laying it out if only the rotation changed in a way
+ * that keeps the logical screen size (UR <-> UD, CW <-> CCW, square modes).
+ */
+bool fbcon_decor_revalidate(struct vc_data *vc, struct fb_info *info)
+{
+	u32 xres = info->var.xres, yres = info->var.yres;
+	u32 bytespp = DIV_ROUND_UP(info->var.bits_per_pixel, 8);
+	int rotate, from;
+	u8 *pic;
+
+	WARN_CONSOLE_UNLOCKED();
+
+	if (!fbcon_decor_active_nores(info, vc) ||
+	    (info->flags & FBINFO_MISC_TILEBLITTING) ||
+	    !fbcon_decor_bpp_ok(info->var.bits_per_pixel) ||
+	    info->bgdecor.width != xres || info->bgdecor.height != yres ||
+	    info->bgdecor.depth != info->var.bits_per_pixel)
+		return false;
+
+	rotate = fbcon_decor_vc_rotate(vc, info);
+	if (!fbcon_decor_box_fits(info, vc, rotate))
+		return false;
+
+	from = info->bgdecor_rotate;
+	if (from == rotate)
+		return true;
+
+	if (FBCON_SWAP(from, xres, yres) != FBCON_SWAP(rotate, xres, yres))
+		return false;
+
+	pic = vmalloc(fbcon_decor_pic_size(xres, yres, bytespp));
+	if (!pic)
+		return false;
+
+	fbcon_decor_relayout_pic(pic, (const u8 *)info->bgdecor.data,
+				 xres, yres, bytespp, from, rotate);
+	vfree(info->bgdecor.data);
+	info->bgdecor.data = pic;
+	info->bgdecor_rotate = rotate;
+
+	return true;
+}
+
+/* Enables fbcondecor on a virtual console; called with console sem held. */
+static int fbcon_decor_enable(struct vc_data *vc)
+{
+	struct fb_info *info = fbcon_decor_info(vc->vc_num);
+	struct vc_decor *d = &vc->vc_decor;
+	int ret;
+
+	if (!info || d->state || !d->theme ||
+	    d->twidth < vc->vc_font.width || d->theight < vc->vc_font.height ||
+	    !fbcon_decor_box_fits(info, vc, fbcon_decor_vc_rotate(vc, info)))
+		return -EINVAL;
+
+	d->state = 1;
+
+	/* The foreground console needs a usable picture right away. */
+	if (vc->vc_num == fg_console && !fbcon_decor_revalidate(vc, info)) {
+		d->state = 0;
+		return -EINVAL;
+	}
+
+	ret = vc_resize(vc, d->twidth / vc->vc_font.width,
+			d->theight / vc->vc_font.height);
+	if (ret) {
+		d->state = 0;
+		return ret;
+	}
+
+	if (con_is_visible(vc))
+		redraw_screen(vc, 0);
+
+	pr_info("fbcondecor: switched decor state to 'on' on console %d\n",
+		vc->vc_num);
+
+	return 0;
+}
+
+/*
+ * Deferred fix-ups after a console switch.  fbcon_switch() may be reached
+ * from contexts where we can't allocate or resize, so the heavy lifting
+ * (re-laying out the picture, resizing, kicking the helper) happens here.
+ */
+static DECLARE_BITMAP(fbcon_decor_fixup_pending, MAX_NR_CONSOLES);
+static DECLARE_BITMAP(fbcon_decor_fixup_reload, MAX_NR_CONSOLES);
+static DEFINE_SPINLOCK(fbcon_decor_fixup_lock);
+
+static void fbcon_decor_fixup_fn(struct work_struct *work)
+{
+	DECLARE_BITMAP(pending, MAX_NR_CONSOLES);
+	DECLARE_BITMAP(reload, MAX_NR_CONSOLES);
+	unsigned long flags;
+	int i;
+
+	spin_lock_irqsave(&fbcon_decor_fixup_lock, flags);
+	bitmap_copy(pending, fbcon_decor_fixup_pending, MAX_NR_CONSOLES);
+	bitmap_copy(reload, fbcon_decor_fixup_reload, MAX_NR_CONSOLES);
+	bitmap_zero(fbcon_decor_fixup_pending, MAX_NR_CONSOLES);
+	bitmap_zero(fbcon_decor_fixup_reload, MAX_NR_CONSOLES);
+	spin_unlock_irqrestore(&fbcon_decor_fixup_lock, flags);
+
+	for_each_set_bit(i, pending, MAX_NR_CONSOLES) {
+		struct vc_data *vc;
+		struct fb_info *info;
+
+		console_lock();
+
+		vc = vc_cons[i].d;
+		info = vc ? fbcon_decor_info(i) : NULL;
+		if (!info || !info->fbcon_par)
+			goto next;
+
+		if (test_bit(i, reload)) {
+			/*
+			 * fbcon_decor_switch() turned decorations off; give the
+			 * console its full size back and let the helper load
+			 * this console's theme.
+			 */
+			if (vc->vc_decor.state || !vc->vc_decor.theme)
+				goto next;
+			fbcon_decor_resize_full(vc, info);
+			if (i == fg_console)
+				fbcon_decor_call_helper("modechange", vc, info);
+		} else if (fbcon_decor_active_vc(vc) && i == fg_console) {
+			if (fbcon_decor_revalidate(vc, info)) {
+				redraw_screen(vc, 0);
+			} else {
+				fbcon_decor_disable(vc, true);
+				fbcon_decor_call_helper("modechange", vc, info);
+			}
+		}
+next:
+		console_unlock();
+	}
+}
+
+static DECLARE_WORK(fbcon_decor_fixup_work, fbcon_decor_fixup_fn);
+
+static void fbcon_decor_queue_fixup(struct vc_data *vc, bool reload)
+{
+	unsigned long flags;
+
+	if (!fbcon_decor_wq)
+		return;
+
+	spin_lock_irqsave(&fbcon_decor_fixup_lock, flags);
+	set_bit(vc->vc_num, fbcon_decor_fixup_pending);
+	if (reload)
+		set_bit(vc->vc_num, fbcon_decor_fixup_reload);
+	spin_unlock_irqrestore(&fbcon_decor_fixup_lock, flags);
+
+	queue_work(fbcon_decor_wq, &fbcon_decor_fixup_work);
+}
+
+/* Called from fbcon_switch() once the blitting ops for @vc are set up. */
+void fbcon_decor_switch(struct vc_data *vc, struct fb_info *info,
+			struct vc_data *prev, struct fb_info *prev_info)
+{
+	if (!fbcon_decor_active_vc(vc)) {
+		/*
+		 * Clear the screen to avoid displaying funky colors during
+		 * palette updates when leaving a decorated console.
+		 */
+		if (prev && prev != vc && prev_info == info &&
+		    fbcon_decor_active_vc(prev) &&
+		    info->fix.visual == FB_VISUAL_DIRECTCOLOR)
+			fbcon_decor_wipe(info);
+		return;
+	}
+
+	if (prev != vc &&
+	    (!prev || prev_info != info || !prev->vc_decor.theme ||
+	     strcmp(vc->vc_decor.theme, prev->vc_decor.theme))) {
+		/* The current picture belongs to some other theme. */
+		vc->vc_decor.state = 0;
+		fbcon_decor_queue_fixup(vc, true);
+		return;
+	}
+
+	if (!fbcon_decor_active(info, vc))
+		fbcon_decor_queue_fixup(vc, false);
+}
+
+/* Called from fbcon_modechanged() for the visible console. */
+void fbcon_decor_modechanged(struct vc_data *vc, struct fb_info *info)
+{
+	if (!fbcon_decor_active_vc(vc) || fbcon_decor_revalidate(vc, info))
+		return;
+
+	fbcon_decor_disable(vc, false);
+	fbcon_decor_call_helper("modechange", vc, info);
+}
+
+void fbcon_decor_vc_deinit(struct vc_data *vc)
+{
+	kfree(vc->vc_decor.theme);
+	memset(&vc->vc_decor, 0, sizeof(vc->vc_decor));
+}
+
+static void fbcon_decor_free_pic(struct fb_image *img)
+{
+	vfree(img->data);
+	kfree(img->cmap.red);
+	memset(img, 0, sizeof(*img));
+}
+
+void fbcon_decor_fb_unregistered(struct fb_info *info)
+{
+	fbcon_decor_free_pic(&info->bgdecor);
+}
+
+/* fb_set_cmap() hook: keep the console colors right on DIRECTCOLOR visuals. */
+void fbcon_decor_cmap_changed(struct fb_info *info)
+{
+	struct fbcon_ops *ops = info->fbcon_par;
+	struct vc_data *vc;
+
+	if (info->fix.visual != FB_VISUAL_DIRECTCOLOR || !ops ||
+	    ops->currcon < 0 || ops->currcon >= MAX_NR_CONSOLES)
+		return;
+
+	vc = vc_cons[ops->currcon].d;
+	if (vc && fbcon_decor_active(info, vc))
+		fbcon_decor_fix_pseudo_pal(info, vc);
+}
+
+/*
+ * fbcon_set_palette() hook.  Returns true if the palette has been taken
+ * care of and fbcon must not load its own.
+ */
+bool fbcon_decor_set_palette(struct vc_data *vc, struct fb_info *info)
+{
+	/* Serialized by the console lock. */
+	static u16 ramp[3][256];
+
+	if (!fbcon_decor_active(info, vc))
+		return false;
+
+	if (info->fix.visual == FB_VISUAL_DIRECTCOLOR) {
+		int minlen = min3(info->var.red.length, info->var.green.length,
+				  info->var.blue.length);
+		struct fb_cmap cmap = {
+			.start = 0,
+			.red = ramp[0],
+			.green = ramp[1],
+			.blue = ramp[2],
+		};
+		int i;
+
+		if (minlen <= 0 || minlen > 8)
+			return false;
+
+		cmap.len = 1 << minlen;
+		for (i = 0; i < cmap.len; i++)
+			ramp[0][i] = ramp[1][i] = ramp[2][i] =
+				(0xffff * i) / (cmap.len - 1);
+
+		fb_set_cmap(&cmap, info);
+		fbcon_decor_fix_pseudo_pal(info, vc);
+		return true;
+	}
+
+	if (info->var.bits_per_pixel == 8 && info->bgdecor.cmap.red)
+		fb_set_cmap(&info->bgdecor.cmap, info);
+
+	return false;
+}
+
+/* ---------------------------------------------------------------------- */
+/* ioctl interface                                                         */
+/* ---------------------------------------------------------------------- */
+
+struct fbcon_decor_pic_req {
+	u32 width, height;
+	u8 depth;
+	const void __user *data;
+	u32 cmap_start, cmap_len;
+	const u16 __user *red, *green, *blue;
+};
+
+static struct vc_data *fbcon_decor_get_vc(unsigned short vc_num)
+{
+	WARN_CONSOLE_UNLOCKED();
+
+	if (vc_num >= MAX_NR_CONSOLES)
+		return NULL;
+
+	return vc_cons[vc_num].d;
+}
+
+static int fbcon_decor_ioctl_setstate(unsigned short vc_num,
+				      unsigned int state)
+{
+	struct vc_data *vc;
+	int ret = -EINVAL;
+
+	console_lock();
+	vc = fbcon_decor_get_vc(vc_num);
+	if (vc)
+		ret = state ? fbcon_decor_enable(vc) :
+			      fbcon_decor_disable(vc, true);
+	console_unlock();
+
+	return ret;
+}
+
+static int fbcon_decor_ioctl_getstate(unsigned short vc_num,
+				      unsigned int *state)
+{
+	struct vc_data *vc;
+	int ret = -EINVAL;
+
+	console_lock();
+	vc = fbcon_decor_get_vc(vc_num);
+	if (vc) {
+		*state = vc->vc_decor.state;
+		ret = 0;
+	}
+	console_unlock();
+
+	return ret;
+}
+
+static int fbcon_decor_ioctl_setcfg(unsigned short vc_num,
+				    const struct vc_decor *cfg,
+				    const char __user *utheme)
+{
+	struct fb_info *info;
+	struct vc_data *vc;
+	char *theme;
+	u32 lw, lh;
+	int rotate, ret = -EINVAL;
+
+	theme = strndup_user(utheme, FBCON_DECOR_THEME_LEN);
+	if (IS_ERR(theme))
+		return PTR_ERR(theme);
+
+	console_lock();
+
+	vc = fbcon_decor_get_vc(vc_num);
+	info = vc ? fbcon_decor_info(vc_num) : NULL;
+	if (!info || !theme[0])
+		goto out;
+
+	rotate = fbcon_decor_vc_rotate(vc, info);
+	lw = FBCON_SWAP(rotate, info->var.xres, info->var.yres);
+	lh = FBCON_SWAP(rotate, info->var.yres, info->var.xres);
+
+	if (cfg->twidth < vc->vc_font.width ||
+	    cfg->theight < vc->vc_font.height ||
+	    cfg->tx + cfg->twidth > lw || cfg->ty + cfg->theight > lh)
+		goto out;
+
+	if (vc->vc_decor.state)
+		fbcon_decor_disable(vc, true);
+
+	kfree(vc->vc_decor.theme);
+	vc->vc_decor.bg_color = cfg->bg_color;
+	vc->vc_decor.state = 0;
+	vc->vc_decor.tx = cfg->tx;
+	vc->vc_decor.ty = cfg->ty;
+	vc->vc_decor.twidth = cfg->twidth;
+	vc->vc_decor.theight = cfg->theight;
+	vc->vc_decor.theme = theme;
+	theme = NULL;
+
+	pr_info("fbcondecor: console %d using theme '%s'\n",
+		vc->vc_num, vc->vc_decor.theme);
+	ret = 0;
+out:
+	console_unlock();
+	kfree(theme);
+
+	return ret;
+}
+
+static int fbcon_decor_ioctl_getcfg(unsigned short vc_num,
+				    struct vc_decor *cfg, char __user *utheme)
+{
+	char theme[FBCON_DECOR_THEME_LEN] = "";
+	struct vc_data *vc;
+
+	console_lock();
+	vc = fbcon_decor_get_vc(vc_num);
+	if (!vc) {
+		console_unlock();
+		return -EINVAL;
+	}
+	*cfg = vc->vc_decor;
+	if (vc->vc_decor.theme)
+		strscpy(theme, vc->vc_decor.theme, sizeof(theme));
+	console_unlock();
+
+	cfg->theme = (char __force *)utheme;
+
+	if (copy_to_user(utheme, theme, strlen(theme) + 1))
+		return -EFAULT;
+
+	return 0;
+}
+
+static int fbcon_decor_ioctl_setpic(unsigned short vc_num,
+				    const struct fbcon_decor_pic_req *req)
+{
+	struct fb_image old = { };
+	struct fb_info *info;
+	struct vc_data *vc;
+	u32 xres, yres, bpp, bytespp, lw, lh;
+	u16 *cmap = NULL;
+	u8 *src = NULL, *pic = NULL;
+	size_t size;
+	int rotate, ret = -EINVAL;
+
+	/* Snapshot the mode the picture has to match. */
+	console_lock();
+	vc = fbcon_decor_get_vc(vc_num);
+	info = vc ? fbcon_decor_info(vc_num) : NULL;
+	if (!info || vc_num != fg_console || !info->fbcon_par) {
+		console_unlock();
+		return -EINVAL;
+	}
+	xres = info->var.xres;
+	yres = info->var.yres;
+	bpp = info->var.bits_per_pixel;
+	rotate = fbcon_decor_vc_rotate(vc, info);
+	console_unlock();
+
+	lw = FBCON_SWAP(rotate, xres, yres);
+	lh = FBCON_SWAP(rotate, yres, xres);
+
+	if (!fbcon_decor_bpp_ok(bpp)) {
+		pr_err("fbcondecor: unsupported framebuffer depth %u\n", bpp);
+		return -EINVAL;
+	}
+
+	if (req->width != lw || req->height != lh) {
+		pr_err("fbcondecor: picture dimensions mismatch: %ux%u vs %ux%u%s\n",
+		       req->width, req->height, lw, lh,
+		       rotate == FB_ROTATE_CW || rotate == FB_ROTATE_CCW ?
+		       " (console is rotated, picture must be too)" : "");
+		return -EINVAL;
+	}
+
+	if (req->depth != bpp) {
+		pr_err("fbcondecor: picture depth mismatch: %u vs %u\n",
+		       req->depth, bpp);
+		return -EINVAL;
+	}
+
+	if (bpp == 8) {
+		size_t clen;
+
+		if (!req->cmap_len || req->cmap_len > 256 ||
+		    req->cmap_start + req->cmap_len > 256 ||
+		    !req->red || !req->green || !req->blue)
+			return -EINVAL;
+
+		clen = req->cmap_len * sizeof(u16);
+		cmap = kmalloc_array(3, clen, GFP_KERNEL);
+		if (!cmap)
+			return -ENOMEM;
+
+		if (copy_from_user(cmap, req->red, clen) ||
+		    copy_from_user((u8 *)cmap + clen, req->green, clen) ||
+		    copy_from_user((u8 *)cmap + 2 * clen, req->blue, clen)) {
+			ret = -EFAULT;
+			goto err;
+		}
+	}
+
+	bytespp = DIV_ROUND_UP(bpp, 8);
+	size = fbcon_decor_pic_size(xres, yres, bytespp);
+
+	src = size ? vmalloc(size) : NULL;
+	if (!src) {
+		ret = -ENOMEM;
+		goto err;
+	}
+
+	if (copy_from_user(src, req->data, size)) {
+		ret = -EFAULT;
+		goto err;
+	}
+
+	if (rotate != FB_ROTATE_UR) {
+		pic = vmalloc(size);
+		if (!pic) {
+			ret = -ENOMEM;
+			goto err;
+		}
+		fbcon_decor_layout_pic(pic, src, xres, yres, bytespp, rotate);
+		vfree(src);
+	} else {
+		pic = src;
+	}
+	src = NULL;
+
+	console_lock();
+
+	/* Things may have changed while we weren't holding the lock. */
+	if (vc_num != fg_console || vc_cons[vc_num].d != vc ||
+	    fbcon_decor_info(vc_num) != info ||
+	    info->var.xres != xres || info->var.yres != yres ||
+	    info->var.bits_per_pixel != bpp ||
+	    fbcon_decor_vc_rotate(vc, info) != rotate) {
+		console_unlock();
+		ret = -EAGAIN;
+		goto err;
+	}
+
+	old = info->bgdecor;
+	memset(&info->bgdecor, 0, sizeof(info->bgdecor));
+	info->bgdecor.width = xres;
+	info->bgdecor.height = yres;
+	info->bgdecor.depth = bpp;
+	info->bgdecor.data = (const char *)pic;
+	if (cmap) {
+		info->bgdecor.cmap.start = req->cmap_start;
+		info->bgdecor.cmap.len = req->cmap_len;
+		info->bgdecor.cmap.red = cmap;
+		info->bgdecor.cmap.green = cmap + req->cmap_len;
+		info->bgdecor.cmap.blue = cmap + 2 * req->cmap_len;
+	}
+	info->bgdecor_rotate = rotate;
+
+	if (fbcon_decor_active(info, vc) && con_is_visible(vc))
+		redraw_screen(vc, 0);
+
+	console_unlock();
+
+	fbcon_decor_free_pic(&old);
+	return 0;
+
+err:
+	vfree(src);
+	vfree(pic);
+	kfree(cmap);
+	return ret;
+}
+
+static long fbcon_decor_ioctl(struct file *filp, unsigned int cmd,
+			      unsigned long arg)
+{
+	struct fbcon_decor_iowrapper __user *wrapper = (void __user *)arg;
+	struct fbcon_decor_iowrapper w;
+	void __user *data;
+	int ret;
+
+	if (copy_from_user(&w, wrapper, sizeof(w)))
+		return -EFAULT;
+	data = (void __user *)w.data;
+
+	switch (cmd) {
+	case FBIOCONDECOR_SETPIC:
+	{
+		struct fbcon_decor_pic_req req;
+		struct fb_image img;
+
+		if (copy_from_user(&img, data, sizeof(img)))
+			return -EFAULT;
+
+		req.width = img.width;
+		req.height = img.height;
+		req.depth = img.depth;
+		req.data = (const void __user *)img.data;
+		req.cmap_start = img.cmap.start;
+		req.cmap_len = img.cmap.len;
+		req.red = (const u16 __user *)img.cmap.red;
+		req.green = (const u16 __user *)img.cmap.green;
+		req.blue = (const u16 __user *)img.cmap.blue;
+
+		return fbcon_decor_ioctl_setpic(w.vc, &req);
+	}
+	case FBIOCONDECOR_SETCFG:
+	{
+		struct vc_decor cfg;
+
+		if (copy_from_user(&cfg, data, sizeof(cfg)))
+			return -EFAULT;
+
+		return fbcon_decor_ioctl_setcfg(w.vc, &cfg,
+					(const char __user __force *)cfg.theme);
+	}
+	case FBIOCONDECOR_GETCFG:
+	{
+		struct vc_decor cfg;
+
+		if (copy_from_user(&cfg, data, sizeof(cfg)))
+			return -EFAULT;
+
+		ret = fbcon_decor_ioctl_getcfg(w.vc, &cfg,
+					       (char __user __force *)cfg.theme);
+		if (ret)
+			return ret;
+
+		if (copy_to_user(data, &cfg, sizeof(cfg)))
+			return -EFAULT;
+		return 0;
+	}
+	case FBIOCONDECOR_SETSTATE:
+	{
+		unsigned int state;
+
+		if (get_user(state, (unsigned int __user *)data))
+			return -EFAULT;
+
+		return fbcon_decor_ioctl_setstate(w.vc, state);
+	}
+	case FBIOCONDECOR_GETSTATE:
+	{
+		unsigned int state;
+
+		ret = fbcon_decor_ioctl_getstate(w.vc, &state);
+		if (ret)
+			return ret;
+
+		return put_user(state, (unsigned int __user *)data);
+	}
+	default:
+		return -ENOIOCTLCMD;
+	}
+}
+
+#ifdef CONFIG_COMPAT
+
+struct fbcon_decor_iowrapper32 {
+	unsigned short vc;		/* Virtual console */
+	unsigned char origin;		/* Point of origin of the request */
+	compat_uptr_t data;
+};
+
+struct fbcon_decor_cmap32 {
+	u32 start;
+	u32 len;
+	compat_uptr_t red;
+	compat_uptr_t green;
+	compat_uptr_t blue;
+	compat_uptr_t transp;
+};
+
+struct fbcon_decor_image32 {
+	u32 dx;
+	u32 dy;
+	u32 width;
+	u32 height;
+	u32 fg_color;
+	u32 bg_color;
+	u8  depth;
+	compat_uptr_t data;
+	struct fbcon_decor_cmap32 cmap;
+};
+
+struct vc_decor32 {
+	u8 bg_color;
+	u8 state;
+	u16 tx, ty;
+	u16 twidth, theight;
+	compat_uptr_t theme;
+};
+
+#define FBIOCONDECOR_SETCFG32	_IOWR('F', 0x19, struct fbcon_decor_iowrapper32)
+#define FBIOCONDECOR_GETCFG32	_IOR('F', 0x1A, struct fbcon_decor_iowrapper32)
+#define FBIOCONDECOR_SETSTATE32	_IOWR('F', 0x1B, struct fbcon_decor_iowrapper32)
+#define FBIOCONDECOR_GETSTATE32	_IOR('F', 0x1C, struct fbcon_decor_iowrapper32)
+#define FBIOCONDECOR_SETPIC32	_IOWR('F', 0x1D, struct fbcon_decor_iowrapper32)
+
+static long fbcon_decor_compat_ioctl(struct file *filp, unsigned int cmd,
+				     unsigned long arg)
+{
+	struct fbcon_decor_iowrapper32 __user *wrapper = compat_ptr(arg);
+	struct fbcon_decor_iowrapper32 w;
+	void __user *data;
+	int ret;
+
+	if (copy_from_user(&w, wrapper, sizeof(w)))
+		return -EFAULT;
+	data = compat_ptr(w.data);
+
+	switch (cmd) {
+	case FBIOCONDECOR_SETPIC32:
+	{
+		struct fbcon_decor_pic_req req;
+		struct fbcon_decor_image32 img;
+
+		if (copy_from_user(&img, data, sizeof(img)))
+			return -EFAULT;
+
+		req.width = img.width;
+		req.height = img.height;
+		req.depth = img.depth;
+		req.data = compat_ptr(img.data);
+		req.cmap_start = img.cmap.start;
+		req.cmap_len = img.cmap.len;
+		req.red = compat_ptr(img.cmap.red);
+		req.green = compat_ptr(img.cmap.green);
+		req.blue = compat_ptr(img.cmap.blue);
+
+		return fbcon_decor_ioctl_setpic(w.vc, &req);
+	}
+	case FBIOCONDECOR_SETCFG32:
+	{
+		struct vc_decor32 cfg32;
+		struct vc_decor cfg;
+
+		if (copy_from_user(&cfg32, data, sizeof(cfg32)))
+			return -EFAULT;
+
+		cfg.bg_color = cfg32.bg_color;
+		cfg.state = cfg32.state;
+		cfg.tx = cfg32.tx;
+		cfg.ty = cfg32.ty;
+		cfg.twidth = cfg32.twidth;
+		cfg.theight = cfg32.theight;
+		cfg.theme = NULL;
+
+		return fbcon_decor_ioctl_setcfg(w.vc, &cfg,
+						compat_ptr(cfg32.theme));
+	}
+	case FBIOCONDECOR_GETCFG32:
+	{
+		struct vc_decor32 cfg32;
+		struct vc_decor cfg;
+
+		if (copy_from_user(&cfg32, data, sizeof(cfg32)))
+			return -EFAULT;
+
+		ret = fbcon_decor_ioctl_getcfg(w.vc, &cfg,
+					       compat_ptr(cfg32.theme));
+		if (ret)
+			return ret;
+
+		cfg32.bg_color = cfg.bg_color;
+		cfg32.state = cfg.state;
+		cfg32.tx = cfg.tx;
+		cfg32.ty = cfg.ty;
+		cfg32.twidth = cfg.twidth;
+		cfg32.theight = cfg.theight;
+
+		if (copy_to_user(data, &cfg32, sizeof(cfg32)))
+			return -EFAULT;
+		return 0;
+	}
+	case FBIOCONDECOR_SETSTATE32:
+	{
+		compat_uint_t state;
+
+		if (get_user(state, (compat_uint_t __user *)data))
+			return -EFAULT;
+
+		return fbcon_decor_ioctl_setstate(w.vc, state);
+	}
+	case FBIOCONDECOR_GETSTATE32:
+	{
+		unsigned int state;
+
+		ret = fbcon_decor_ioctl_getstate(w.vc, &state);
+		if (ret)
+			return ret;
+
+		return put_user((compat_uint_t)state,
+				(compat_uint_t __user *)data);
+	}
+	default:
+		return -ENOIOCTLCMD;
+	}
+}
+#else
+#define fbcon_decor_compat_ioctl NULL
+#endif /* CONFIG_COMPAT */
+
+static const struct file_operations fbcon_decor_ops = {
+	.owner = THIS_MODULE,
+	.unlocked_ioctl = fbcon_decor_ioctl,
+	.compat_ioctl = fbcon_decor_compat_ioctl,
+};
+
+static struct miscdevice fbcon_decor_dev = {
+	.minor = MISC_DYNAMIC_MINOR,
+	.name = "fbcondecor",
+	.fops = &fbcon_decor_ops,
+};
+
+/* ---------------------------------------------------------------------- */
+/* Setup                                                                   */
+/* ---------------------------------------------------------------------- */
+
+/*
+ * Registration is done from the workqueue: fbcon takes over with the console
+ * lock held, and possibly before the misc class exists (drivers/video is
+ * initialized before drivers/char).
+ */
+static void fbcon_decor_init_fn(struct work_struct *work)
+{
+	struct fb_info *info;
+	struct vc_data *vc;
+	int ret;
+
+	if (!fbcon_decor_registered) {
+		ret = misc_register(&fbcon_decor_dev);
+		if (ret) {
+			pr_err("fbcondecor: failed to register device: %d\n",
+			       ret);
+			return;
+		}
+		fbcon_decor_registered = true;
+
+		fbcon_decor_sysctl_hdr = register_sysctl("kernel",
+							 fbcon_decor_sysctl);
+		if (!fbcon_decor_sysctl_hdr)
+			pr_warn("fbcondecor: failed to register kernel.fbcondecor sysctl\n");
+	}
+
+	console_lock();
+	vc = vc_cons[0].d;
+	info = vc ? fbcon_decor_info(0) : NULL;
+	if (info)
+		fbcon_decor_call_helper("init", vc, info);
+	console_unlock();
+}
+
+static DECLARE_WORK(fbcon_decor_init_work, fbcon_decor_init_fn);
+
+/* Called once from fb_console_init(). */
+void fbcon_decor_setup(void)
+{
+	fbcon_decor_wq = alloc_ordered_workqueue("fbcondecor", 0);
+	if (!fbcon_decor_wq)
+		pr_err("fbcondecor: failed to allocate workqueue\n");
+}
+
+/* Called whenever fbcon takes over the console. */
+void fbcon_decor_init(void)
+{
+	if (fbcon_decor_wq)
+		queue_work(fbcon_decor_wq, &fbcon_decor_init_work);
+}
+
+void fbcon_decor_exit(void)
+{
+	int i;
+
+	if (fbcon_decor_wq) {
+		destroy_workqueue(fbcon_decor_wq);
+		fbcon_decor_wq = NULL;
+	}
+
+	if (fbcon_decor_sysctl_hdr) {
+		unregister_sysctl_table(fbcon_decor_sysctl_hdr);
+		fbcon_decor_sysctl_hdr = NULL;
+	}
+
+	if (fbcon_decor_registered) {
+		misc_deregister(&fbcon_decor_dev);
+		fbcon_decor_registered = false;
+	}
+
+	console_lock();
+	for (i = 0; i < MAX_NR_CONSOLES; i++)
+		if (vc_cons[i].d)
+			fbcon_decor_vc_deinit(vc_cons[i].d);
+	console_unlock();
+}
diff -Nru a/drivers/video/console/fbcondecor.h b/drivers/video/console/fbcondecor.h
--- a/drivers/video/console/fbcondecor.h	1969-12-31 16:00:00.000000000 -0800
+++ b/drivers/video/console/fbcondecor.h	2026-11-08 01:22:18.286156730 -0800
@@ -0,0 +1,189 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ *  fbcondecor.h -- Framebuffer Console Decoration internal interface
+ *
+ *  Copyright (C) 2004 Michal Januszewski <michalj+fbcondecor@gmail.com>
+ *
+ *  Coordinate conventions
+ *  ----------------------
+ *  Theme geometry (struct vc_decor tx/ty/twidth/theight) and the picture
+ *  passed in by FBIOCONDECOR_SETPIC are in console ("logical") space: what
+ *  the viewer sees once fbcon rotation has been applied.  The kernel stores
+ *  the picture in info->bgdecor in physical (framebuffer memory) order, laid
+ *  out for the rotation recorded in info->bgdecor_rotate, so the renderer
+ *  only ever has to transform rectangles, never individual picture pixels.
+ */
+#ifndef _VIDEO_FBCONDECOR_H
+#define _VIDEO_FBCONDECOR_H
+
+#include <linux/fb.h>
+#include <linux/vt_kern.h>
+
+#include "fbcon.h"
+
+struct fb_cursor;
+
+#ifdef CONFIG_FB_CON_DECOR
+
+/* fbcon.c */
+struct fb_info *fbcon_decor_info(int unit);
+int fbcon_decor_vc_rotate(struct vc_data *vc, struct fb_info *info);
+
+/* fbcondecor.c */
+void fbcon_decor_setup(void);
+void fbcon_decor_init(void);
+void fbcon_decor_exit(void);
+void fbcon_decor_call_helper(const char *cmd, struct vc_data *vc,
+			     struct fb_info *info);
+int fbcon_decor_disable(struct vc_data *vc, bool redraw);
+bool fbcon_decor_revalidate(struct vc_data *vc, struct fb_info *info);
+void fbcon_decor_switch(struct vc_data *vc, struct fb_info *info,
+			struct vc_data *prev, struct fb_info *prev_info);
+void fbcon_decor_modechanged(struct vc_data *vc, struct fb_info *info);
+void fbcon_decor_vc_deinit(struct vc_data *vc);
+void fbcon_decor_fb_unregistered(struct fb_info *info);
+void fbcon_decor_cmap_changed(struct fb_info *info);
+bool fbcon_decor_set_palette(struct vc_data *vc, struct fb_info *info);
+
+/* cfbcondecor.c */
+void fbcon_decor_putcs(struct vc_data *vc, struct fb_info *info,
+		       const unsigned short *s, int count, int yy, int xx,
+		       int fg, int bg);
+void fbcon_decor_cursor(struct vc_data *vc, struct fb_info *info,
+			const struct fb_cursor *cursor);
+void fbcon_decor_clear(struct vc_data *vc, struct fb_info *info, int sy,
+		       int sx, int height, int width, int bg);
+void fbcon_decor_clear_margins(struct vc_data *vc, struct fb_info *info,
+			       int bottom_only);
+void fbcon_decor_blank(struct vc_data *vc, struct fb_info *info, int blank);
+void fbcon_decor_wipe(struct fb_info *info);
+void fbcon_decor_fix_pseudo_pal(struct fb_info *info, struct vc_data *vc);
+void fbcon_decor_layout_pic(u8 *dst, const u8 *src, u32 xres, u32 yres,
+			    u32 bytespp, int rotate);
+void fbcon_decor_relayout_pic(u8 *dst, const u8 *src, u32 xres, u32 yres,
+			      u32 bytespp, int from, int to);
+
+static inline bool fbcon_decor_active_vc(const struct vc_data *vc)
+{
+	return vc->vc_decor.state && vc->vc_decor.theme;
+}
+
+static inline bool fbcon_decor_active_nores(const struct fb_info *info,
+					    const struct vc_data *vc)
+{
+	return info->bgdecor.data && fbcon_decor_active_vc(vc);
+}
+
+static inline bool fbcon_decor_bpp_ok(u32 bpp)
+{
+	return bpp == 8 || bpp == 16 || bpp == 24 || bpp == 32;
+}
+
+/* Current rotation fbcon is drawing with on @info. */
+static inline int fbcon_decor_rotation(const struct fb_info *info)
+{
+	const struct fbcon_ops *ops = info->fbcon_par;
+
+	return ops ? ops->rotate : FB_ROTATE_UR;
+}
+
+/* Does the text box of @vc fit the logical screen for @rotate? */
+static inline bool fbcon_decor_box_fits(const struct fb_info *info,
+					const struct vc_data *vc, int rotate)
+{
+	const struct vc_decor *d = &vc->vc_decor;
+	u32 lw = FBCON_SWAP(rotate, info->var.xres, info->var.yres);
+	u32 lh = FBCON_SWAP(rotate, info->var.yres, info->var.xres);
+
+	return d->twidth && d->theight &&
+	       d->tx + d->twidth <= lw && d->ty + d->theight <= lh;
+}
+
+/*
+ * Can decorations be rendered on @info for @vc right now?  Requires a
+ * picture that matches the current mode, depth and rotation, and a text box
+ * that fits the screen.
+ */
+static inline bool fbcon_decor_active(const struct fb_info *info,
+				      const struct vc_data *vc)
+{
+	int rotate;
+
+	if (!fbcon_decor_active_nores(info, vc) ||
+	    (info->flags & FBINFO_MISC_TILEBLITTING) ||
+	    !info->screen_base)
+		return false;
+
+	rotate = fbcon_decor_rotation(info);
+
+	return info->bgdecor.width == info->var.xres &&
+	       info->bgdecor.height == info->var.yres &&
+	       info->bgdecor.depth == info->var.bits_per_pixel &&
+	       fbcon_decor_bpp_ok(info->var.bits_per_pixel) &&
+	       info->bgdecor_rotate == rotate &&
+	       fbcon_decor_box_fits(info, vc, rotate);
+}
+
+/*
+ * Size (in logical pixels) of the area the console text occupies.  Leaves
+ * @w/@h (the full logical screen) untouched unless the theme's text box is
+ * in use.
+ */
+static inline void fbcon_decor_text_area(const struct fb_info *info,
+					 const struct vc_data *vc, int rotate,
+					 int *w, int *h)
+{
+	if (fbcon_decor_active_vc(vc) && fbcon_decor_box_fits(info, vc, rotate)) {
+		*w = vc->vc_decor.twidth;
+		*h = vc->vc_decor.theight;
+	}
+}
+
+#else /* CONFIG_FB_CON_DECOR */
+
+static inline void fbcon_decor_setup(void) {}
+static inline void fbcon_decor_init(void) {}
+static inline void fbcon_decor_exit(void) {}
