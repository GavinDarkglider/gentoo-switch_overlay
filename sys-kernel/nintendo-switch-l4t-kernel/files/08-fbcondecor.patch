+				      struct vc_data *prev,
+				      struct fb_info *prev_info) {}
+static inline void fbcon_decor_modechanged(struct vc_data *vc,
+					   struct fb_info *info) {}
+static inline void fbcon_decor_vc_deinit(struct vc_data *vc) {}
+static inline void fbcon_decor_fb_unregistered(struct fb_info *info) {}
+static inline void fbcon_decor_cmap_changed(struct fb_info *info) {}
+static inline bool fbcon_decor_set_palette(struct vc_data *vc,
+					   struct fb_info *info) { return false; }
+static inline void fbcon_decor_putcs(struct vc_data *vc, struct fb_info *info,
+				     const unsigned short *s, int count,
+				     int yy, int xx, int fg, int bg) {}
+static inline void fbcon_decor_cursor(struct vc_data *vc, struct fb_info *info,
+				      const struct fb_cursor *cursor) {}
+static inline void fbcon_decor_clear(struct vc_data *vc, struct fb_info *info,
+				     int sy, int sx, int height, int width,
+				     int bg) {}
+static inline void fbcon_decor_clear_margins(struct vc_data *vc,
+					     struct fb_info *info,
+					     int bottom_only) {}
+static inline void fbcon_decor_blank(struct vc_data *vc, struct fb_info *info,
+				     int blank) {}
+static inline void fbcon_decor_wipe(struct fb_info *info) {}
+
+static inline bool fbcon_decor_active_vc(const struct vc_data *vc)
+{
+	return false;
+}
+
+static inline bool fbcon_decor_active(const struct fb_info *info,
+				      const struct vc_data *vc)
+{
+	return false;
+}
+
+static inline void fbcon_decor_text_area(const struct fb_info *info,
+					 const struct vc_data *vc, int rotate,
+					 int *w, int *h) {}
+
+#endif /* CONFIG_FB_CON_DECOR */
+
+#endif /* _VIDEO_FBCONDECOR_H */
