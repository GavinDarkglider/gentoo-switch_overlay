diff --git a/installkernel/80-switch-kernel-dts.install b/installkernel/80-switch-kernel-dts.install
index 23e2353..595a210 100755
--- a/installkernel/80-switch-kernel-dts.install
+++ b/installkernel/80-switch-kernel-dts.install
@@ -20,12 +20,19 @@ ewarn() {
 }
 
 
-einfo "build nx-plat.dtimg"
-mkdtboimg.py create ${targetdir}/nx-plat.dtimg --page_size=1000 \
-	${basedir}/dts/tegra210-odin.dtb --id=0x4F44494E \
-	${basedir}/dts/tegra210b01-odin.dtb --id=0x4F44494E --rev=0x00000b01 \
-	${basedir}/dts/tegra210b01-vali.dtb --id=0x56414C49 \
-	${basedir}/dts/tegra210b01-fric.dtb --id=0x46524947 || die "Failed to generate nx-plat.dtimg"
+# make dtbs makes nx-plat.dtimg in kernels that carry the patch for it;
+# pack one here only for kernels that don't
+if [ -f "${basedir}/dts/nx-plat.dtimg" ]; then
+	einfo "use the kernel's nx-plat.dtimg"
+	cp "${basedir}/dts/nx-plat.dtimg" "${targetdir}/nx-plat.dtimg" || die "Failed to copy nx-plat.dtimg"
+else
+	einfo "build nx-plat.dtimg"
+	mkdtboimg.py create ${targetdir}/nx-plat.dtimg --page_size=1000 \
+		${basedir}/dts/tegra210-odin.dtb --id=0x4F44494E \
+		${basedir}/dts/tegra210b01-odin.dtb --id=0x4F44494E --rev=0x00000b01 \
+		${basedir}/dts/tegra210b01-vali.dtb --id=0x56414C49 \
+		${basedir}/dts/tegra210b01-fric.dtb --id=0x46524947 || die "Failed to generate nx-plat.dtimg"
+fi
 
 CTC_VERSION="$(echo ${ver} | cut -d - -f 1 | cut -d . -f 4 | \
 	awk '{print substr($1, 1, 1) "." substr($1, 2, 1) "." substr($1, 3, 1)}')"
