description="Touchegg gesture daemon (libinput reader)"

supervisor="supervise-daemon"
command="/usr/bin/touchegg"
command_args="--daemon"
command_user="root:input"
respawn_delay=5
respawn_max=0

depend() {
	need localmount
	after udev
}
